+sr_error_info_t *
+sr_shmext_change_sub_scrap(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_datastore_t ds, uint32_t sub_id)
+{
+    sr_error_info_t *err_info = NULL;
+    sr_mod_change_sub_t *shm_subs;
+    uint32_t i;
+
+    /* EXT READ LOCK */
+    if ((err_info = sr_shmext_conn_remap_lock(conn, SR_LOCK_READ, 0, __func__))) {
+        return err_info;
+    }
+
+    shm_subs = (sr_mod_change_sub_t *)(conn->ext_shm.addr + shm_mod->change_sub[ds].subs);
+
+    for (i = 0; i < shm_mod->change_sub[ds].sub_count; ++i) {
+        if (shm_subs[i].sub_id == sub_id) {
+            break;
+        }
+    }
+    SR_CHECK_INT_GOTO(i == shm_mod->change_sub[ds].sub_count, err_info, cleanup_unlock);
+
+    /* set the scrap flag in the ext SHM for this subscription */
+    SR_SHMEXT_SUB_SCRAP(shm_subs[i]);
+    SR_LOG_INF("Scrapped change_sub CID %u xpath_id %u",
+                conn->cid, shm_subs[i].xpath_id);
+
+cleanup_unlock:
+    /* EXT READ UNLOCK */
+    sr_shmext_conn_remap_unlock(conn, SR_LOCK_READ, 0, __func__);
+
+    return err_info;
+}
