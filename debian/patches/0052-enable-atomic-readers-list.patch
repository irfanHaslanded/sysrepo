+/*
+ * Check if we have room for cid in readers
+ * */
+static int
+sr_rwlock_read_available(sr_rwlock_t *rwlock, sr_cid_t cid) {
+    uint32_t i = SR_RWLOCK_READ_LIMIT;
+    sr_cid_t cid_i;
+
+    /* if number of readers is less than limit, we should definitely have room */
+    if (SR_RWLOCK_READERS(rwlock) < SR_RWLOCK_READ_LIMIT) {
+        return 1;
+    }
+
+    /* walking back is going to be faster */
+    do {
+        i--;
+        cid_i = SR_RWLOCK_RD_CID(rwlock, i);
+        if (!cid_i || cid_i == cid) {
+            return 1;
+        }
+    } while (i > 0);
+
+    return 0;
 }
 
