From: IrfanMohammad <irfan@graphiant.com>
Date: Wed, 26 Jul 2023 17:48:51 +0000
Subject: remove noisy log of sr_get_item no data

---
 src/log.c       | 33 +++++++++++++++++++++++++--------
 src/log.h       | 10 ++++++++++
 src/sysrepo.c   |  2 +-
 tests/tcommon.c |  1 -
 4 files changed, 36 insertions(+), 10 deletions(-)

diff --git a/src/log.c b/src/log.c
index e15055a..14b394f 100644
--- a/src/log.c
+++ b/src/log.c
@@ -127,7 +127,6 @@ sr_log_msg(int plugin, sr_log_level_t ll, const char *msg)
         severity = "DBG";
         break;
     case SR_LL_NONE:
-        assert(0);
         return;
     }
 
@@ -214,10 +213,9 @@ sr_errinfo_add(sr_error_info_t **err_info, sr_error_t err_code, const char *err_
     ++(*err_info)->err_count;
 }
 
-void
-sr_errinfo_new(sr_error_info_t **err_info, sr_error_t err_code, const char *msg_format, ...)
+static void
+_sr_errinfo_new_with_level(sr_error_info_t **err_info, sr_log_level_t ll, sr_error_t err_code, const char *msg_format, va_list *vargs)
 {
-    va_list vargs;
     int idx;
 
     if ((err_code == SR_ERR_NO_MEMORY) && !msg_format) {
@@ -229,16 +227,35 @@ sr_errinfo_new(sr_error_info_t **err_info, sr_error_t err_code, const char *msg_
         sr_errinfo_add(err_info, err_code, NULL, NULL, NULL, NULL);
         return;
     } else {
-        va_start(vargs, msg_format);
-        sr_errinfo_add(err_info, err_code, NULL, NULL, msg_format, &vargs);
-        va_end(vargs);
+        sr_errinfo_add(err_info, err_code, NULL, NULL, msg_format, vargs);
     }
 
     /* print it */
     idx = (*err_info)->err_count - 1;
-    sr_log_msg(0, SR_LL_ERR, (*err_info)->err[idx].message);
+    sr_log_msg(0, ll, (*err_info)->err[idx].message);
 }
 
+void
+sr_errinfo_new_with_level(sr_error_info_t **err_info, sr_log_level_t ll, sr_error_t err_code, const char *msg_format, ...)
+{
+    va_list vargs;
+
+    va_start(vargs, msg_format);
+    _sr_errinfo_new_with_level(err_info, ll, err_code, msg_format, &vargs);
+    va_end(vargs);
+}
+
+
+void
+sr_errinfo_new(sr_error_info_t **err_info, sr_error_t err_code, const char *msg_format, ...)
+{
+    va_list vargs;
+
+    va_start(vargs, msg_format);
+    _sr_errinfo_new_with_level(err_info, SR_LL_ERR, err_code, msg_format, &vargs);
+    va_end(vargs);
+ }
+
 void
 sr_errinfo_new_data(sr_error_info_t **err_info, sr_error_t err_code, const char *err_format, const void *err_data,
         const char *msg_format, ...)
diff --git a/src/log.h b/src/log.h
index d7e65b8..e5cdd5f 100644
--- a/src/log.h
+++ b/src/log.h
@@ -124,4 +124,14 @@ void sr_errinfo_merge(sr_error_info_t **err_info, sr_error_info_t *err_info2);
  */
 void sr_log(sr_log_level_t ll, const char *format, ...) _FORMAT_PRINTF(2, 3);
 
+/**
+ * @brief Log a message with variable arguments.
+ *
+ * @param[in] ll Log level (severity).
+ * @param[in] format Message format.
+ * @param[in] ... Format arguments.
+ */
+void
+sr_errinfo_new_with_level(sr_error_info_t **err_info, sr_log_level_t ll,
+        sr_error_t err_code, const char *msg_format, ...) __attribute__ ((format (printf, 4, 5)));
 #endif
diff --git a/src/sysrepo.c b/src/sysrepo.c
index 1d44e61..c884416 100644
--- a/src/sysrepo.c
+++ b/src/sysrepo.c
@@ -2801,7 +2801,7 @@ sr_get_item(sr_session_ctx_t *session, const char *path, uint32_t timeout_ms, sr
         sr_errinfo_new(&err_info, SR_ERR_INVAL_ARG, "More subtrees match \"%s\".", path);
         goto cleanup;
     } else if (!set->count) {
-        sr_errinfo_new(&err_info, SR_ERR_NOT_FOUND, "No data found for \"%s\".", path);
+        sr_errinfo_new_with_level(&err_info, SR_LL_NONE, SR_ERR_NOT_FOUND, "No data found for \"%s\".", path);
         goto cleanup;
     }
 
diff --git a/tests/tcommon.c b/tests/tcommon.c
index b851388..5ef6047 100644
--- a/tests/tcommon.c
+++ b/tests/tcommon.c
@@ -50,7 +50,6 @@ _test_log_msg(sr_log_level_t level, const char *message, const char *prefix)
         severity = "DBG";
         break;
     case SR_LL_NONE:
-        assert(0);
         return;
     }
 
