diff --git a/tests/test_modules.c b/tests/test_modules.c
index e43d76b..520b7a5 100644
--- a/tests/test_modules.c
+++ b/tests/test_modules.c
@@ -1611,10 +1611,50 @@ test_running_disabled(void **state)
     assert_int_equal(ret, SR_ERR_OK);
 }
 
+static void
+test_install_modules_perm(void **state)
+{
+    struct state *st = (struct state *)*state;
+    int ret;
+    const char *paths[] = {
+        TESTS_SRC_DIR "/../modules/sysrepo-plugind.yang",
+        TESTS_SRC_DIR "/../modules/sysrepo.yang",
+        TESTS_SRC_DIR "/files/test.yang",
+        NULL
+    };
+    char *owner = NULL, *group = NULL;
+    mode_t perm;
+    mode_t set_perms[] = {0604, 0600, 0660, 0644, 0644};
+    int i;
+
+    for (i = 0; i < 5; i++) {
+        /* install test-module */
+        ret = sr_install_modules_perm(st->conn, paths, 3, TESTS_SRC_DIR "/files", NULL, NULL, set_perms[i]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        owner = NULL;
+        group = NULL;
+        ret = sr_get_module_ds_access(st->conn, "test", SR_DS_RUNNING, &owner, &group, &perm);
+        assert_int_equal(ret, SR_ERR_OK);
+        assert_int_equal(perm, set_perms[i]);
+        free(owner);
+        free(group);
+        ret = sr_get_module_ds_access(st->conn, "sysrepo-plugind", SR_DS_RUNNING, &owner, &group, &perm);
+        free(owner);
+        free(group);
+        assert_int_equal(ret, SR_ERR_OK);
+        assert_int_equal(perm, set_perms[i]);
+    }
+
+    ret = sr_remove_module(st->conn, "test", 0);
+    assert_int_equal(ret, SR_ERR_OK);
+}
+
 int
