diff --git a/src/sysrepo.c b/src/sysrepo.c
index 1698ac8..0de807b 100644
--- a/src/sysrepo.c
+++ b/src/sysrepo.c
@@ -7261,3 +7261,35 @@ sr_set_module_access(sr_conn_ctx_t *conn, const char *module_name, const char *o
     }
     return ret;
 }
+
+API int
+sr_module_rwlock_debug(sr_conn_ctx_t *conn, const char *module_name, uint32_t mask)
+{
+#define CHECK_NEXT_BIT (mask & (1u << bit++))
+    sr_main_shm_t *main_shm = SR_CONN_MAIN_SHM(conn);
+    uint32_t bit = 0;
+    sr_error_info_t *err_info = NULL;
+    if (!strcmp("sr_context_lock", module_name)) {
+        sr_rwlock_debug_set(&main_shm->context_lock, mask > 0);
+        return 0;
+    }
+
+    sr_mod_t *shm_mod = sr_shmmod_find_module(SR_CONN_MOD_SHM(conn), module_name);
+    SR_CHECK_INT_GOTO(!shm_mod, err_info, cleanup);
+
+    sr_rwlock_debug_set(&shm_mod->data_lock_info[SR_DS_RUNNING].data_lock, CHECK_NEXT_BIT);
+    sr_rwlock_debug_set(&shm_mod->data_lock_info[SR_DS_OPERATIONAL].data_lock, CHECK_NEXT_BIT);
+
+    sr_rwlock_debug_set(&shm_mod->change_sub[SR_DS_RUNNING].lock, CHECK_NEXT_BIT);
+    sr_rwlock_debug_set(&shm_mod->change_sub[SR_DS_OPERATIONAL].lock, CHECK_NEXT_BIT);
+
+    sr_rwlock_debug_set(&shm_mod->oper_get_lock, CHECK_NEXT_BIT);
+    sr_rwlock_debug_set(&shm_mod->oper_poll_lock, CHECK_NEXT_BIT);
+    sr_rwlock_debug_set(&shm_mod->notif_lock, CHECK_NEXT_BIT);
+    sr_rwlock_debug_set(&shm_mod->rpc_ext_lock, CHECK_NEXT_BIT);
+
+#undef CHECK_NEXT_BIT
+cleanup:
+    return sr_api_ret(NULL, err_info);
+}
+
