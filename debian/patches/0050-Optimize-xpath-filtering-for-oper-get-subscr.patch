+API int
+sr_module_has_change_sub(sr_conn_ctx_t *conn, const char *module_name,
+        const sr_datastore_t ds, char ***xpaths, uint32_t *sub_count)
+{
+    char *xpath;
+    size_t i = 0;
+    sr_error_info_t *err_info = NULL;
+    sr_mod_change_sub_t *change_subs;
+
+    SR_CHECK_ARG_APIRET(!xpaths || !sub_count || !conn || !module_name ||
+            (ds > SR_DS_FACTORY_DEFAULT), NULL, err_info);
+
+    *xpaths = NULL;
+
+    /* CONTEXT LOCK */
+    if ((err_info = sr_lycc_lock(conn, SR_LOCK_READ, 0, __func__))) {
+        return sr_api_ret(NULL, err_info);
+    }
+
+    sr_mod_t *shm_mod = sr_shmmod_find_module(SR_CONN_MOD_SHM(conn), module_name);
+    if (!shm_mod) {
+        sr_errinfo_new(&err_info, SR_ERR_NOT_FOUND, "Module \"%s\" was not found in sysrepo.", module_name);
+        goto cleanup;
+    }
+
+    *sub_count = shm_mod->change_sub[ds].sub_count;
+    if (!*sub_count) {
+        goto cleanup;
+    }
+
+    /* CHANGE SUB READ LOCK */
+    if ((err_info = sr_rwlock(&shm_mod->change_sub[ds].lock, SR_SHMEXT_SUB_LOCK_TIMEOUT, SR_LOCK_READ, conn->cid,
+            __func__, NULL, NULL))) {
+        goto change_sub_unlock;
+    }
+
+    /* EXT READ LOCK */
+    if ((err_info = sr_shmext_conn_remap_lock(conn, SR_LOCK_READ, 0, __func__))) {
+        goto change_ext_sub_unlock;
+    }
+
+    change_subs = (sr_mod_change_sub_t *)(conn->ext_shm.addr + shm_mod->change_sub[ds].subs);
+
+    *xpaths = malloc(*sub_count * sizeof (*xpaths));
+
+    for (i = 0; i < *sub_count; i++) {
+        errno = 0;
+        xpath = conn->ext_shm.addr + change_subs[i].xpath;
+        (*xpaths)[i] = xpath ? strdup(xpath) : NULL;
+
+        if (errno) {
+            SR_ERRINFO_SYSERRNO(&err_info, "strdup");
+            sr_errinfo_new(&err_info, SR_ERR_INTERNAL, "Out of memory");
+            goto cleanup_mem;
+        }
+    }
+    goto change_ext_sub_unlock;
+
+cleanup_mem:
+    while (i) {
+        free((*xpaths)[i]);
+        i--;
+    }
+    free(*xpaths);
+    *xpaths = NULL;
+
+change_ext_sub_unlock:
+        /* EXT READ UNLOCK */
+        sr_shmext_conn_remap_unlock(conn, SR_LOCK_READ, 0, __func__);
+
+change_sub_unlock:
+        /* CHANGE SUB READ UNLOCK */
+        sr_rwunlock(&shm_mod->change_sub[ds].lock, SR_SHMEXT_SUB_LOCK_TIMEOUT, SR_LOCK_READ, conn->cid, __func__);
+
+cleanup:
+    sr_lycc_unlock(conn, SR_LOCK_READ, 0, __func__);
+    return sr_api_ret(NULL, err_info);
+}
