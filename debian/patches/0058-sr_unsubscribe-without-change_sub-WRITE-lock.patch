+/**
+ * @brief cleanup any scrapped subscriptions because unsubscribe could not get a WRITE lock for change_sub.
+ * */
+static sr_error_info_t *
+sr_shmext_change_sub_remove_scrapped(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_datastore_t ds,
+        sr_lock_mode_t *has_lock)
+{
+    sr_error_info_t *err_info = NULL;
+    uint32_t i;
+    sr_mod_change_sub_t *shm_sub;
+    assert(*has_lock == SR_LOCK_WRITE);
+
+    /* EXT READ LOCK */
+    if ((err_info = sr_shmext_conn_remap_lock(conn, SR_LOCK_READ, 1, __func__))) {
+        return err_info;
+    }
+
+    for (i = 0; i < shm_mod->change_sub[ds].sub_count; ++i) {
+        shm_sub = (sr_mod_change_sub_t *)(conn->ext_shm.addr + shm_mod->change_sub[ds].subs);
+        if (SR_SHMEXT_IS_SUB_SCRAPPED(shm_sub[i])) {
+            /* subscription was deleted in a hurry, recover it */
+            SR_LOG_DBG("Freeing scrapped change_sub with xpath_id %u", shm_sub[i].xpath_id);
+
+            if ((err_info = sr_shmext_change_sub_free(conn, shm_mod, ds, i))) {
+                goto cleanup_unlock;
+            }
+        }
+    }
+
+cleanup_unlock:
+    /* EXT READ UNLOCK */
+    sr_shmext_conn_remap_unlock(conn, SR_LOCK_READ, 1, __func__);
+    return err_info;
+}
