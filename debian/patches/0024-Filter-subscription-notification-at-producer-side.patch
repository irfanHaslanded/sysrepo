+
+    ret = sr_set_item_str(st->sess, "/test:l1[k='other_key']/v", "25", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    for (i = 0; i < 4; i++) {
+        assert_int_equal(expected_counts[i], stats[i].count);
+    }
+
+    for (i = 0; i < 4; i++) {
