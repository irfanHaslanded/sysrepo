+static void
+test_subscr_oper_update_deadlock(void **arg)
+{
+    int NUM_XPATHS = test_full_scale ? 100 : 10;
+    pthread_t tid;
+    struct state *st = (struct state *)*arg;
+    int i, ret;
+    cb_stats stats = {0};
+
+    sr_subscription_ctx_t *subscr = {NULL};
+    sr_subscr_options_t opts = SR_SUBSCR_ENABLED;
+
+    ATOMIC_STORE_RELAXED(st->running, 1);
+
+    ret = sr_session_start(st->conn, SR_DS_OPERATIONAL, &st->sess);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    /* Launch a new thread that will make changes to test-leafref */
+    pthread_create(&tid, NULL, test_subscr_oper_update_deadlock_helper, st);
+
+    /* First setup oper subscription to module */
+    ret = sr_module_change_subscribe(st->sess, "test-leafref", NULL, module_change_cb, &stats,
+                  0, SR_SUBSCR_ENABLED, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    sr_session_switch_ds(st->sess, SR_DS_RUNNING);
+
+    /* Setup many running config subscriptions on the same thread */
+    for (i = 0; i < NUM_XPATHS; i++) {
+        ret = sr_module_change_subscribe(st->sess, "test-leafref", NULL, module_change_cb, &stats,
+                      0, opts, &subscr);
+        assert_int_equal(ret, SR_ERR_OK);
+        sched_yield();
+    }
+
+    ret = sr_unsubscribe(subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ATOMIC_STORE_RELAXED(st->running, 0);
+    pthread_join(tid, NULL);
+
+    ret = sr_session_stop(st->sess);
+    assert_int_equal(ret, SR_ERR_OK);
+}
