@@ -99,9 +89,10 @@ if(ENABLE_TESTS)
     endforeach()
     add_test(NAME test_sysrepocfg_oper_import COMMAND ${PROJECT_SOURCE_DIR}/tests/test_sysrepocfg_oper.sh WORKING_DIRECTORY ${CMAKE_BINARY_DIR})
     set_property(TEST test_sysrepocfg_oper_import APPEND PROPERTY ENVIRONMENT
