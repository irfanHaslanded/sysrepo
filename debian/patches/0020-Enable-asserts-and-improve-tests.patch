+ * This will test a scenario with a number of processes, each with many threads.
+ * Multiple modules will be manipulated, and the processes can be restarted.
+ * Each process will have threads that do the following
+ * main()
+ *  1. sr_connect
+ *  2. create change subscriptions to running and oper store
+ *  3. create oper subscriptions (a.k.a pull or data-provider)
+ *  4. create rpc and notif subscriptions
+ *  5. push config and oper data
+ *  6. read data from multiple modules
+ *  7. fetch oper data both pushed and pull (data provider)
+ *  8. sr_disconnect
+ *
+ * The test will not abort on any single failure, but continue to run for a duration of time
+ *
+ * @copyright
+ * Copyright 2022 Graphiant
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *    http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+#define _GNU_SOURCE
+
+#include <string.h>
+#include <unistd.h>
+#include <setjmp.h>
+#include <stdarg.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+
+#include <cmocka.h>
+#include <libyang/libyang.h>
+
+#include "sysrepo.h"
+#include "common.h"
+#include "tests/tcommon.h"
+
+static int test_full_scale = 0;
+static ATOMIC_T keep_running;
+
+struct timespec start_time;
+
+struct state
+{
+    sr_conn_ctx_t *conn;
+    sr_session_ctx_t *sess;
+    sr_session_ctx_t  *oper_sess;
+    sr_subscription_ctx_t *subscr[2];
+};
+
+static int
+setup_f(void **state)
+{
+    struct state *st;
+    const char *schema_paths[] = {
+        TESTS_SRC_DIR "/files/test.yang",
+        TESTS_SRC_DIR "/files/test-leafref.yang",
+        TESTS_SRC_DIR "/files/ietf-interfaces.yang",
+        TESTS_SRC_DIR "/files/test-module.yang",
+        TESTS_SRC_DIR "/files/iana-if-type.yang",
+        TESTS_SRC_DIR "/files/ietf-if-aug.yang",
+        NULL
+    };
+
+    st = calloc(1, sizeof *st);
+    *state = st;
+
+    if (sr_connect(0, &(st->conn)) != SR_ERR_OK) {
+        return 1;
+    }
+
+    if (sr_install_modules(st->conn, schema_paths, TESTS_SRC_DIR "/files", NULL) != SR_ERR_OK) {
+        return 1;
+    }
+
+    clock_gettime(CLOCK_MONOTONIC, &start_time);
+    return 0;
+}
+
+static int
+teardown_f(void **state)
+{
+    struct state *st = (struct state *)*state;
+    const char *module_names[] = {
+        "test-leafref",
+        "test-module",
+        "iana-if-type",
+        "ietf-interfaces",
+        "test",
+        NULL
+    };
+
+    sr_remove_modules(st->conn, module_names, 0);
+
+    sr_disconnect(st->conn);
+    free(st);
+    return 0;
+}
+
+typedef struct {
+    ATOMIC_T count;
+} cb_stats;
+
+static int
+module_change_cb(sr_session_ctx_t *session, uint32_t sub_id, const char *module_name, const char *xpath,
+        sr_event_t event, uint32_t request_id, void *private_data)
+{
+    (void)session;
+    (void)sub_id;
+    (void)module_name;
+    (void)xpath;
+    (void)event;
+    (void)request_id;
+    cb_stats *stats = (cb_stats *)private_data;
+    ATOMIC_INC_RELAXED(stats->count);
+    if (xpath && !strcmp("test-module", module_name) && !strcmp(xpath, "/test-module:main/string")) {
+        TLOG_INF("Stopping everything");
+        ATOMIC_STORE_RELAXED(keep_running, 0);
+    }
+    return 0;
+}
+
+static int
+dummy_oper_cb(sr_session_ctx_t *session, uint32_t sub_id, const char *module_name, const char *xpath,
+        const char *request_xpath, uint32_t request_id, struct lyd_node **parent, void *private_data)
+{
+    (void)session;
+    (void)sub_id;
+    (void)module_name;
+    (void)xpath;
+    (void)request_xpath;
+    (void)request_id;
+    (void)parent;
+    (void)private_data;
+    return 0;
+}
+
+static int
+recursive_oper_cb(sr_session_ctx_t *session, uint32_t sub_id, const char *module_name, const char *xpath,
+        const char *request_xpath, uint32_t request_id, struct lyd_node **parent, void *private_data)
+{
+    sr_data_t *tmp = NULL;
+    const char *get_xpath = "/test:*";
+    (void)session;
+    (void)sub_id;
+    (void)module_name;
+    (void)xpath;
+    (void)request_xpath;
+    (void)request_id;
+    (void)parent;
+    (void)private_data;
+    int ret;
+
+    if (!strcmp(module_name, "test")) {
+        get_xpath = "/test-leafref:*";
+    }
+    ret = sr_get_data(session, get_xpath, 0, 0, 0, &tmp);
+    assert_int_equal(ret, SR_ERR_OK);
+    sr_release_data(tmp);
+    return SR_ERR_OK;
+}
+
+static int
+module_change_recursive_get_cb(sr_session_ctx_t *session, uint32_t sub_id, const char *module_name, const char *xpath,
+        sr_event_t event, uint32_t request_id, void *private_data)
+{
+    sr_data_t *tmp = NULL;
+    const char *get_xpath = "/test:*";
+    (void)session;
+    (void)sub_id;
+    (void)module_name;
+    (void)xpath;
+    (void)event;
+    (void)request_id;
+    int ret;
+
+    cb_stats *stats = (cb_stats *)private_data;
+    ATOMIC_INC_RELAXED(stats->count);
+    if (!strcmp(module_name, "test")) {
+        get_xpath = "/test-leafref:*";
+    }
+    ret = sr_get_data(session, get_xpath, 0, 0, 0, &tmp);
+    assert_int_equal(ret, SR_ERR_OK);
+    sr_release_data(tmp);
+
+    return 0;
+}
+
+static void *
+test_massive_scale_helper(void *arg)
+{
+    (void)arg;
+    const int TEST_RUN_SECONDS = test_full_scale ? 30 : 1;
+    sr_subscr_options_t opts = SR_SUBSCR_ENABLED;
+    int ret;
+    cb_stats stats = {0};
+    struct timespec now;
+    struct state st;
+    long id = gettid();
+    char xpath[128];
+    sr_data_t *tmp;
+    sr_conn_ctx_t *conn = NULL, *conn2 = NULL;
+    sr_session_ctx_t *sess = NULL;
+    sr_subscription_ctx_t *subscr = NULL;
+    int i = 0;
+
+    ret = sr_connect(0, &conn);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_session_start(conn, SR_DS_RUNNING, &sess);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_module_change_subscribe(sess, "test-module", "/test-module:main/string", module_change_cb, &stats,
+            0, SR_SUBSCR_DONE_ONLY, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    do {
+        memset(&st, 0, sizeof st);
+        tmp = NULL;
+        ret = sr_connect(0, &conn2);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_session_start(conn2, SR_DS_RUNNING, &st.sess);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_session_start(conn2, SR_DS_OPERATIONAL, &st.oper_sess);
+        assert_int_equal(ret, SR_ERR_OK);
+        /* Create running ds change subscriptions */
+        ret = sr_module_change_subscribe(st.sess, "ietf-interfaces", NULL, module_change_cb, &stats,
+                0, opts, &st.subscr[0]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_module_change_subscribe(st.sess, "test", "/test:l1[k='interested_key']", module_change_cb, &stats,
+                0, opts, &st.subscr[0]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_module_change_subscribe(st.sess, "test", "/test:l1[k='other_key']", module_change_cb, &stats,
+                0, opts, &st.subscr[0]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_module_change_subscribe(st.sess, "test", NULL, module_change_recursive_get_cb, &stats,
+                0, opts, &st.subscr[0]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        /* Create operational ds change subscriptions */
+        ret = sr_module_change_subscribe(st.oper_sess, "ietf-interfaces", NULL, module_change_cb, &stats,
+                0, opts, &st.subscr[0]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        /* Create operational pull subscriptions */
+        snprintf(xpath, sizeof xpath, "/test-leafref:car-state/enabled-params[.='key%lu']", id);
+
+        ret = sr_oper_get_subscribe(st.oper_sess, "test-leafref", xpath, recursive_oper_cb, NULL, 0, &st.subscr[1]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        /* Push some config into datastore */
+        snprintf(xpath, sizeof xpath, "/ietf-interfaces:interfaces/interface[name='eth%lu']/type", id);
+        ret = sr_set_item_str(st.sess, xpath, "iana-if-type:ethernetCsmacd", NULL, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+        ret = sr_apply_changes(st.sess, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        /* Push operational data into datastore */
+        snprintf(xpath, sizeof xpath, "/ietf-interfaces:interfaces-state/interface[name='eth%lu']/type", id);
+
+        ret = sr_set_item_str(st.oper_sess, xpath,
+                "iana-if-type:ethernetCsmacd", NULL, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+        ret = sr_apply_changes(st.oper_sess, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        /* Read all operational data */
+        ret = sr_get_data(st.oper_sess, "/*", 0, 0, 0, &tmp);
+        assert_int_equal(ret, SR_ERR_OK);
+        sr_release_data(tmp);
+
+        /* Read all configuration */
+
+        ret = sr_get_data(st.sess, "/*", 0, 0, 0, &tmp);
+        assert_int_equal(ret, SR_ERR_OK);
+        sr_release_data(tmp);
+
+        /* Delete config */
+        snprintf(xpath, sizeof xpath, "/ietf-interfaces:interfaces/interface[name='eth%lu']", id);
+        ret = sr_delete_item(st.sess, xpath, SR_EDIT_STRICT);
+        ret = sr_apply_changes(st.sess, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        if (++i%2) {
+            /* Delete operational data */
+            snprintf(xpath, sizeof xpath, "/ietf-interfaces:interfaces-state/interface[name='eth%lu']", id);
+            ret = sr_delete_item(st.oper_sess, xpath, SR_EDIT_STRICT);
+            ret = sr_apply_changes(st.oper_sess, 0);
+            assert_int_equal(ret, SR_ERR_OK);
+        }
+
+        /* Remove all subscriptions */
+        ret = sr_unsubscribe(st.subscr[0]);
+        assert_int_equal(ret, SR_ERR_OK);
+        ret = sr_unsubscribe(st.subscr[1]);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_session_stop(st.sess);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_session_stop(st.oper_sess);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        sr_disconnect(conn2);
+        conn2 = NULL;
+
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        sched_yield();
+    } while(ATOMIC_LOAD_RELAXED(keep_running) && now.tv_sec < start_time.tv_sec + TEST_RUN_SECONDS);
+
+    if (!ATOMIC_LOAD_RELAXED(keep_running)) {
+        TLOG_WRN("Stopping early");
+    }
+    sr_unsubscribe(subscr);
+    sr_disconnect(conn);
+    return NULL;
+}
+
+static void
+test_multi_proc_scale(void **arg)
+{
+    (void)arg;
+    sr_conn_ctx_t *conn = NULL;
+    sr_session_ctx_t *sess = NULL;
+
+    const int NUM_PROCS = test_full_scale ? 8 : 1;
+    int i, rc, ret, result = 0;
+    pid_t pids[NUM_PROCS];
+    ATOMIC_STORE_RELAXED(keep_running, 1);
+
+    ret = sr_connect(0, &conn);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_session_start(conn, SR_DS_RUNNING, &sess);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    for (i = 0; i < NUM_PROCS; i++) {
+        switch (pids[i] = fork()) {
+            case 0:
+                /* child process */
+                test_massive_scale_helper(NULL);
+                exit(0);
+                break;
+            default:
+                break;
+        }
+    }
+
+    for (i = 0; i < NUM_PROCS; i++) {
+        rc = 0;
+        wait(&rc);
+        TLOG_WRN("Returned rc %d", rc);
+        if (!result && rc) {
+            ret = sr_set_item_str(sess, "/test-module:main/string", "stop_all_tests", NULL, 0);
+            assert_int_equal(ret, SR_ERR_OK);
+            ret = sr_apply_changes(sess, 0);
+            assert_int_equal(ret, SR_ERR_OK);
+        }
+        result += rc;
+    }
+    sr_disconnect(conn);
+
+    assert_int_equal(result, 0);
+}
+
+static void
+test_multi_thread_scale(void **arg)
+{
+    const int NUM_THREADS = test_full_scale ? 8 : 1;
+    int i, ret;
+    pthread_t tids[NUM_THREADS];
+    (void)arg;
+
+    ATOMIC_STORE_RELAXED(keep_running, 1);
+
+    for (i = 0; i < NUM_THREADS; i++) {
+        ret = pthread_create(&tids[i], NULL, test_massive_scale_helper, NULL);
+        assert_int_equal(ret, 0);
+    }
+
+    for (i = 0; i < NUM_THREADS; i++) {
+        pthread_join(tids[i], NULL);
+    }
+
+}
+
+int
+main(void)
+{
+    const struct CMUnitTest tests[] = {
+        cmocka_unit_test(test_multi_proc_scale),
+        cmocka_unit_test(test_multi_thread_scale),
+    };
+    test_full_scale = getenv("TEST_FULL_SCALE") != NULL;
+    setenv("CMOCKA_TEST_ABORT", "1", 1);
+    test_log_init();
+    return cmocka_run_group_tests(tests, setup_f, teardown_f);
+}
