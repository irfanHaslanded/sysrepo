+static void
+test_oper_gnmi_set(void **arg)
+{
+    sr_conn_ctx_t *conn = NULL;
+    sr_session_ctx_t *oper_sess = NULL;
+    struct state *st = (struct state *)*arg;
+    int ret;
+    sr_data_t *data = NULL;
+
+    const char *xpath =  "/gnmi-server-test:test-state/things[name=\"to-cpe2'\"]";
+    const char *xpath_next = "/gnmi-server-test:test-state/things[name=\"to-cpe2'\"]/counter";
+
+    const char *xpath2 =  "/gnmi-server-test:test-state/things[name='to-cpe1\"']";
+    const char *xpath2_next = "/gnmi-server-test:test-state/things[name='to-cpe2\"']/counter";
+
+    const char *val = "8";
+
+    ret = sr_connect(0, &conn);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_session_start(st->conn, SR_DS_OPERATIONAL, &oper_sess);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(oper_sess, xpath, "", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(oper_sess, xpath_next, val, NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(oper_sess, xpath2, "", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(oper_sess, xpath2_next, val, NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(oper_sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    TLOG_INF("Added oper data");
+
+    ret = sr_get_data(oper_sess, "/gnmi-server-test:*", 0, 0, 0, &data);
+    assert_int_equal(ret, SR_ERR_OK);
+    sr_release_data(data);
+    data = NULL;
+
+    ret = sr_session_stop(oper_sess);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    sr_disconnect(conn);
+}
+
