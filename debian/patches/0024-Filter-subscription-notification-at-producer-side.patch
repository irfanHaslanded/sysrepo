+/* TEST */
+/*
+ * Test for skipped change event when not holding locks during enable subscription creation
+ * There is a window between the enabled event callback and subscription addition,
+ * that a sr_apply_changes can sneak in, and not have any notification to the newly created subscription.
+ * subscription subs_lock must be obtained before downgrading shm_mod change sub lock to read.
+ * In this test, the enabled callback has a barrier to force the change to be triggered while the subscr is being setup
+ */
+static void
+test_subscr_enable_apply_race(void **arg)
+{
+    struct state *st = (struct state *)*arg;
+    int ret;
+    pthread_t tid;
+
+    ATOMIC_STORE_RELAXED(st->running, 1);
+    pthread_barrier_init(&st->barrier, NULL, 2);
+
+    sr_session_start(st->conn, SR_DS_RUNNING, &st->sess);
+
+    TLOG_INF("Step 1. Add some init_data");
+    ret = sr_set_item_str(st->sess, "/test:l1[k='init_data']/v", "1", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    TLOG_INF("Step 2. Create a sub with enable flag");
+    pthread_create(&tid, NULL, test_enable_subscr_add_del, st);
+
+    TLOG_INF("Step 3. Wait for enabled subscr to be created");
+    pthread_barrier_wait(&st->barrier);
+    pthread_barrier_wait(&st->barrier);
+
+    TLOG_INF("Step 4. Adding data that should not skip the callback");
+    ret = sr_set_item_str(st->sess, "/test:l1[k='dont_skip_data']/v", "2", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    TLOG_INF("dont_skip_data added");
+
+    TLOG_INF("Step 5. This delete will be notified");
+    ret = sr_delete_item(st->sess, "/test:l1[k='new_data']/v", 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_delete_item(st->sess, "/test:l1[k='init_data']/v", 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_delete_item(st->sess, "/test:l1[k='dont_skip_data']/v", 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    TLOG_INF("All data deleted");
+
+    /* Step 5. Signal to unsubscribe and finish */
+    pthread_barrier_wait(&st->barrier);
+    pthread_join(tid, NULL);
+
+    assert_int_equal(6, ATOMIC_LOAD_RELAXED(st->invocation_count));
+    ret = sr_session_stop(st->sess);
+    assert_int_equal(ret, SR_ERR_OK);
+}
