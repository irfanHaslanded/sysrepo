From: IrfanMohammad <irfan@graphiant.com>
Date: Sun, 29 Oct 2023 14:10:33 +0000
Subject: bugfix edit_diff add followed by del

When delete follows a set in an edit, they are both deleted. However this
is not correct. The delete should act on all previous sets, and also on
the stored data.

Closes: ENG-5756
---
 src/edit_diff.c        | 17 +++++++++++------
 src/sysrepo.c          |  9 ++++++---
 tests/test_oper_push.c | 34 +++++++++++++++++++++++++++++++---
 3 files changed, 48 insertions(+), 12 deletions(-)

diff --git a/src/edit_diff.c b/src/edit_diff.c
index df619d5..3699fec 100644
--- a/src/edit_diff.c
+++ b/src/edit_diff.c
@@ -3003,17 +3003,18 @@ sr_edit_add_descendant_have_own_op(const struct lyd_node *sibling, enum edit_op
  * @return err_info, NULL on success.
  */
 static sr_error_info_t *
-sr_edit_add_merge_op(struct lyd_node *match, struct lyd_node **root, const char *value, enum edit_op op)
+sr_edit_add_merge_op(struct lyd_node *match, struct lyd_node **root, const char *value, enum edit_op op, int *same_op)
 {
     sr_error_info_t *err_info = NULL;
     const struct lysc_node *schema;
     struct lyd_node *parent = NULL, *sibling = NULL;
     enum edit_op cur_op;
     int own_oper;
-
+    *same_op = 0;
     cur_op = sr_edit_diff_find_oper(match, 1, &own_oper);
     if (op == cur_op) {
         /* same node with same operation, silently ignore */
+        *same_op = 1;
         goto cleanup;
     }
 
@@ -3525,12 +3526,13 @@ sr_edit_add(sr_session_ctx_t *session, const char *xpath, const char *value, con
     const char *meta_val = NULL, *def_origin;
     char *rel_xpath = NULL;
     enum edit_op op;
-    int opts, own_oper;
-
+    int opts, own_oper, same_op = 0;
+    int removal = 0;
     assert(!origin || strchr(origin, ':'));
 
     opts = LYD_NEW_PATH_WITH_OPAQ;
     if (!strcmp(operation, "remove") || !strcmp(operation, "delete") || !strcmp(operation, "purge")) {
+        removal = 1;
         opts |= LYD_NEW_PATH_OPAQ;
     }
 
@@ -3542,10 +3544,13 @@ sr_edit_add(sr_session_ctx_t *session, const char *xpath, const char *value, con
         }
         if (match) {
             /* node exists, nothing to create, just merge operations if possible */
-            if ((err_info = sr_edit_add_merge_op(match, &session->dt[session->ds].edit->tree, value, sr_edit_str2op(operation)))) {
+            if ((err_info = sr_edit_add_merge_op(match, &session->dt[session->ds].edit->tree, value, sr_edit_str2op(operation), &same_op))) {
                 goto error_safe;
             }
-            goto success;
+            /* We want to delete not just what's in the edit but what's in datastore as well */
+            if (same_op || !removal) {
+                goto success;
+            }
         }
     }
 
diff --git a/src/sysrepo.c b/src/sysrepo.c
index 52adab6..06349c6 100644
--- a/src/sysrepo.c
+++ b/src/sysrepo.c
@@ -3381,7 +3381,7 @@ cleanup:
 }
 
 API int
-sr_delete_item(sr_session_ctx_t *session, const char *path, const sr_edit_options_t opts)
+sr_delete_item(sr_session_ctx_t *session, const char *path, const sr_edit_options_t in_opts)
 {
     sr_error_info_t *err_info = NULL;
     const char *operation;
@@ -3389,8 +3389,11 @@ sr_delete_item(sr_session_ctx_t *session, const char *path, const sr_edit_option
     uint32_t temp_lo = 0;
     int isolate = SR_EDIT_ISOLATE & opts;
 
-    if (isolate && SR_DS_OPERATIONAL == session->ds) {
-        return sr_discard_items(session, path);
+    sr_edit_options_t opts = in_opts;
+
+    if (session && session->ds == SR_DS_OPERATIONAL) {
+        /* operational datastore does not support isolate flag */
+        opts &= ~SR_EDIT_ISOLATE;
     }
 
     SR_CHECK_ARG_APIRET(!session || !path || SR_EDIT_DS_API_CHECK(session->ds, opts), session, err_info);
