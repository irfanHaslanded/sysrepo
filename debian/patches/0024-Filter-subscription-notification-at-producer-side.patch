+            0, opts, &subscr[i]);
+    assert_int_equal(ret, 0);
+    i++;
+
+    ret = sr_module_change_subscribe(st->sess, "test", "/test:l1[k='key2']", module_change_cb, &stats[i],
+                0, opts, &subscr[i]);
+    assert_int_equal(ret, 0);
+    i++;
+
+    ret = sr_module_change_subscribe(st->sess, "test", "/test:l1[k='key3']", module_change_cb, &stats[i],
+                0, opts, &subscr[i]);
+    assert_int_equal(ret, 0);
+    i++;
+
+    /* Start a subscription to another module which always fails */
+    ret = sr_module_change_subscribe(st->sess, "test-leafref", NULL, module_error_cb, &stats[i],
+                0, opts, &subscr[i]);
+    assert_int_equal(ret, 0);
+    i++;
+
+    memset(stats, 0, sizeof(stats));
+    ret = sr_set_item_str(st->sess, "/test:l1[k='other_key']/v", "25", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(st->sess, "/test-leafref:car/parameters[name='temperature']", NULL, NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    /* perform 1st change */
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_CALLBACK_FAILED);
+
+    ret = sr_discard_changes(st->sess);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    for (i = 0; i < 4; i++) {
+        assert_int_equal(expected_counts[i], stats[i].count);
