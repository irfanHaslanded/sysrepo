-        err_info = sr_install_modules_check_features(new_mod, no_changes);
+        if ((err_info = sr_install_modules_check_features(new_mod, no_changes))) {
+            goto cleanup;
+        }
+        if (!strcmp(new_mod->ly_mod->name, "sysrepo")) {
+            goto cleanup;
+        }
+        /* check and install permissions */
+        sr_update_access(conn, new_mod);
         goto cleanup;
     }
 
@@ -8011,3 +8047,36 @@ cleanup:
     return sr_api_ret(NULL, err_info);
 }
 
+API int
+sr_install_modules_perm(sr_conn_ctx_t *conn, const char **schema_paths, uint32_t new_mod_count,
+        const char *search_dirs, const char *owner, const char *group, mode_t perm)
+{
+    sr_error_info_t *err_info = NULL;
+    sr_int_install_mod_t *new_mods = NULL;
+    uint32_t i;
+    int rc = SR_ERR_OK;
+
+    SR_CHECK_ARG_APIRET(!conn || !schema_paths, NULL, err_info);
+    /* alloc */
+    new_mods = calloc(new_mod_count, sizeof *new_mods);
+    SR_CHECK_MEM_GOTO(!new_mods, err_info, cleanup);
+
+    /* fill all the items */
+    for (i = 0; i < new_mod_count; ++i) {
+        new_mods[i].schema_path = schema_paths[i];
+        new_mods[i].owner = owner;
+        new_mods[i].group = group;
+        new_mods[i].perm = perm;
+    }
+    /* install */
+    rc = _sr_install_modules(conn, search_dirs, NULL, NULL, 0, &new_mods, &new_mod_count);
+
+cleanup:
+    free(new_mods);
+    if (err_info) {
+        return sr_api_ret(NULL, err_info);
+    } else {
+        return rc;
+    }
+}
