diff --git a/tests/test_get.c b/tests/test_get.c
index c3b6838..bd54d77 100644
--- a/tests/test_get.c
+++ b/tests/test_get.c
@@ -47,6 +47,8 @@ setup(void **state)
         TESTS_SRC_DIR "/files/simple.yang",
         TESTS_SRC_DIR "/files/simple-aug.yang",
         TESTS_SRC_DIR "/files/defaults.yang",
+        TESTS_SRC_DIR "/files/referenced-data.yang",
+        TESTS_SRC_DIR "/files/test-module.yang",
         NULL
     };
 
@@ -82,17 +84,74 @@ teardown(void **state)
         "simple-aug",
         "simple",
         "defaults",
+        "test-module",
+        "referenced-data",
         NULL
     };
 
     sr_remove_modules(st->conn, module_names, 0);
-
     sr_disconnect(st->conn);
     sr_disconnect(st->cconn);
     free(st);
     return 0;
 }
 
+/* TEST */
+static void
+test_get_enum(void **state)
+{
+    struct state *st = (struct state *)*state;
+    sr_val_t *vals = NULL;
+    size_t vals_cnt = 0;
+    int ret;
+
+    /* set enum which has an explicit value */
+    ret = sr_set_item_str(st->sess, "/test-module:main/enum", "yes", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    /* read it back as an enum (string) */
+    ret = sr_get_items(st->sess, "/test-module:main/enum", 0, SR_OPER_DEFAULT, &vals, &vals_cnt);
+    assert_int_equal(ret, SR_ERR_OK);
+    assert_int_equal(vals[0].type, SR_ENUM_T);
+    assert_string_equal(vals[0].data.enum_val, "yes");
+    sr_free_values(vals, vals_cnt);
+
+    /* read it back as the underlying value (int) */
+    vals = NULL;
+    vals_cnt = 0;
+    ret = sr_get_items(st->sess, "/test-module:main/enum", 0, SR_UNDERLYING_VALUE, &vals, &vals_cnt);
+    assert_int_equal(ret, SR_ERR_OK);
+    assert_int_equal(vals[0].type, SR_INT32_T);
+    assert_int_equal(vals[0].data.int32_val, 1);
+    sr_free_values(vals, vals_cnt);
+
+    /* set enum which does not have an explicit value */
+    ret = sr_set_item_str(st->sess, "/test-module:main/enum", "maybe", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    /* read it back as an enum (string) */
+    vals = NULL;
+    vals_cnt = 0;
+    ret = sr_get_items(st->sess, "/test-module:main/enum", 0, SR_OPER_DEFAULT, &vals, &vals_cnt);
+    assert_int_equal(ret, SR_ERR_OK);
+    assert_int_equal(vals[0].type, SR_ENUM_T);
+    assert_string_equal(vals[0].data.enum_val, "maybe");
+    sr_free_values(vals, vals_cnt);
+
+    /* read it back as the underlying value (int) */
+    vals = NULL;
+    vals_cnt = 0;
+    ret = sr_get_items(st->sess, "/test-module:main/enum", 0, SR_UNDERLYING_VALUE, &vals, &vals_cnt);
+    assert_int_equal(ret, SR_ERR_OK);
+    assert_int_equal(vals[0].type, SR_INT32_T);
+    assert_int_equal(vals[0].data.int32_val, 3);
+    sr_free_values(vals, vals_cnt);
+}
+
 /* TEST */
 static void
 test_invalid(void **state)
@@ -641,6 +700,7 @@ main(void)
         cmocka_unit_test(test_union),
         cmocka_unit_test(test_key),
         cmocka_unit_test(test_factory_default),
+        cmocka_unit_test(test_get_enum),
     };
 
     setenv("CMOCKA_TEST_ABORT", "1", 1);
