+static int
+sr_xpath_is_entire_module(const char *xpath)
+{
+    int mod_len = 0;
+
+    if (xpath[0] != '/') {
+        return 0;
+    }
+
+    /* get module name offset from xpath */
+    sr_xpath_next_qname(xpath + 1, NULL, &mod_len, NULL, NULL);
+
+    /* Looking for /module-name:* */
+    return (strcmp(xpath + mod_len + 1, ":*") == 0);
+}
