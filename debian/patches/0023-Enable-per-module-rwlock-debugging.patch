+ * mask options:
+ * data running       0x1
+ * data operational   0x2
+ * change_sub running 0x4
+ * change_sub oper    0x8
+ * oper_get subscr   0x10
+ * oper_poll subscr   0x20
+ * notif 0x40
+ * rpc_ext 0x80
+ * */
+int sr_module_rwlock_debug(sr_conn_ctx_t *conn, const char *module_name, uint32_t mask);
+
 #ifdef __cplusplus
 }
 #endif
