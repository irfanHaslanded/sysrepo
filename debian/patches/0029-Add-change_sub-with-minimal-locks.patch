diff --git a/src/shm_ext.c b/src/shm_ext.c
index 8e133e8..798ce73 100644
--- a/src/shm_ext.c
+++ b/src/shm_ext.c
@@ -555,14 +555,17 @@ sr_shmext_change_sub_remove_dead(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_data
 }
 
 sr_error_info_t *
-sr_shmext_change_sub_add(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_datastore_t ds, uint32_t sub_id, const char *xpath,
-        uint32_t priority, int sub_opts, uint32_t evpipe_num)
+sr_shmext_change_sub_add(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_lock_mode_t *has_lock,
+        sr_datastore_t ds, uint32_t sub_id, const char *xpath, uint32_t priority, int sub_opts, uint32_t evpipe_num)
 {
     sr_error_info_t *err_info = NULL, *tmp_err;
     off_t xpath_off;
     sr_mod_change_sub_t *shm_sub;
     uint32_t i;
 
+    /* kept for possible future use */
+    assert(*has_lock == SR_LOCK_WRITE);
+
     /* EXT WRITE LOCK */
     if ((err_info = sr_shmext_conn_remap_lock(conn, SR_LOCK_WRITE, 1, __func__))) {
         goto cleanup;
@@ -628,6 +631,17 @@ sr_shmext_change_sub_add(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_datastore_t
 cleanup_unlock:
     /* EXT WRITE UNLOCK */
     sr_shmext_conn_remap_unlock(conn, SR_LOCK_WRITE, 1, __func__);
+    /*
+     * Downgrade the write lock to a read upgrade lock, we will unlock after everything is finished
+     * read upgrade lock needed, because we may need to delete the sub if next steps fail
+     * */
+    if (err_info) {
+        goto cleanup;
+    }
+    if (!(err_info = sr_rwrelock(&shm_mod->change_sub[ds].lock, SR_SHMEXT_SUB_LOCK_TIMEOUT, SR_LOCK_READ_UPGR, conn->cid,
+            __func__, NULL, NULL))) {
+        *has_lock = SR_LOCK_READ_UPGR;
+    }
 
 cleanup:
     return err_info;
@@ -738,15 +752,31 @@ cleanup:
 }
 
 sr_error_info_t *
-sr_shmext_change_sub_del(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_datastore_t ds, uint32_t sub_id)
+sr_shmext_change_sub_del(sr_conn_ctx_t *conn, sr_mod_t *shm_mod, sr_lock_mode_t *has_lock,
+        sr_datastore_t ds, uint32_t sub_id)
 {
     sr_error_info_t *err_info = NULL;
     sr_mod_change_sub_t *shm_sub;
     uint32_t i;
 
+    assert((*has_lock == SR_LOCK_NONE) || (*has_lock == SR_LOCK_WRITE || *has_lock == SR_LOCK_READ_UPGR));
+
+    if (*has_lock == SR_LOCK_NONE) {
+        /* CHANGE SUB WRITE LOCK */
+        if ((err_info = sr_rwlock(&shm_mod->change_sub[ds].lock, SR_SHMEXT_SUB_LOCK_TIMEOUT, SR_LOCK_WRITE, conn->cid,
+                __func__, NULL, NULL))) {
+            return err_info;
+        }
+    } else if (*has_lock == SR_LOCK_READ_UPGR) {
+        if ((err_info = sr_rwrelock(&shm_mod->change_sub[ds].lock, SR_SHMEXT_SUB_LOCK_TIMEOUT, SR_LOCK_WRITE, conn->cid,
+                __func__, NULL, NULL))) {
+            return err_info;
+        }
+    }
+
     /* EXT READ LOCK */
     if ((err_info = sr_shmext_conn_remap_lock(conn, SR_LOCK_READ, 1, __func__))) {
-        return err_info;
+        goto cleanup_chsub_unlock;
     }
 
     /* find the subscription */
@@ -770,6 +800,18 @@ cleanup_unlock:
     /* EXT READ UNLOCK */
     sr_shmext_conn_remap_unlock(conn, SR_LOCK_READ, 1, __func__);
 
+cleanup_chsub_unlock:
+    if (*has_lock == SR_LOCK_NONE) {
+        /* CHANGE SUB WRITE UNLOCK */
+        sr_rwunlock(&shm_mod->change_sub[ds].lock, 0, SR_LOCK_WRITE, conn->cid, __func__);
+    } else if (*has_lock == SR_LOCK_READ_UPGR) {
+        /* Downgrade to a read lock */
+        if ((err_info = sr_rwrelock(&shm_mod->change_sub[ds].lock, SR_SHMEXT_SUB_LOCK_TIMEOUT, SR_LOCK_READ, conn->cid,
+                __func__, NULL, NULL))) {
+            return err_info;
+        }
+        *has_lock = SR_LOCK_READ;
+    }
     return err_info;
 }
 
