+/**
+ * @brief When a connection is found to be dead, update the xpath_id list
+ *
+ * @param[in] mod Mod info module to use.
+ * @param[in] del_idx Index to delete
+ * @param[in] sub_count Number of subscribers of this module
+ */
+static void
+sr_shmsub_update_xpath_ids(struct sr_mod_info_mod_s *mod, uint32_t del_idx, uint32_t sub_count)
+{
+    size_t i;
+    uint32_t tmp;
+    assert(mod);
+
+    if (mod->xpath_id_count == 0) {
+        return;
+    }
+
+    assert(mod->filtered_indices);
+    assert(sub_count > 0);
+
+    sub_count--;
+    tmp = mod->filtered_indices[del_idx];
+    /* swap last index with deleted index */
+    mod->filtered_indices[del_idx] = mod->filtered_indices[sub_count];
+    mod->filtered_indices[sub_count] = 0;
+
+    /* Find tmp in xpath_ids and swap with last */
+    for (i = 0; i < mod->xpath_id_count; i++) {
+        if (mod->xpath_ids[i] == tmp) {
+            mod->xpath_id_count--;
+            mod->xpath_ids[i] = mod->xpath_ids[mod->xpath_id_count];
+            mod->xpath_ids[mod->xpath_id_count] = 0;
+            break;
+        }
+    }
+
+    /* if there are no more, release the data */
+    if (!mod->xpath_id_count) {
+        free(mod->filtered_indices);
+        free(mod->xpath_ids);
+        mod->xpath_ids = NULL;
+        mod->filtered_indices = NULL;
+    }
+}
+
+/**
+ * @brief Learn whether xpath event is relevant for this subscription
+ *
+ * @param[in] change_sub change sub module info
+ * @param[in] xpath_ids List of relevant xpaths
+ * @param[in] size size of xpath_ids array
+ * @return 0 if not, 1 if there is.
+ */
+static int
+sr_shmsub_change_is_xpath_event_valid(struct modsub_changesub_s *change_sub, uint32_t *xpath_ids, uint32_t size)
+{
+    /* Search in the xpath_id list */
+    while (size-- > 0) {
+        if (xpath_ids[size] == change_sub->xpath_id) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+/**
+ * @brief Gather a list of all xpath_ids interested in this diff.
+ *
+ * Check mod->xpath_id_count to see how many subscribers are interested
+ *
+ * @param[in] mod_info shm info of the module.
+ * @param[in] mod Mod info module to use.
+ * @return NULL if successful, err_info if error;
+ */
+static sr_error_info_t *
+sr_shmsub_get_relevant_indices(struct sr_mod_info_s *mod_info, struct sr_mod_info_mod_s *mod)
+{
+    sr_error_info_t * err_info = NULL;
+    sr_datastore_t ds = mod_info->ds;
+    sr_conn_ctx_t *conn = mod_info->conn;
+    int count;
+    sr_mod_change_sub_t *shm_sub = NULL;
+    uint32_t *arr = NULL, *xpath_arr = NULL;
+    int i = 0, j = 0, xpath_count = 0;
+
+    /* Ensure no left over data */
+    assert(0 == mod->xpath_id_count);
+
+    /* EXT REMAP READ LOCK */
+    if ((err_info = sr_shmext_conn_remap_lock(conn, SR_LOCK_READ, 0, __func__))) {
+        goto cleanup;
+    }
+
+    count = mod->shm_mod->change_sub[ds].sub_count;
+    if (count == 0) {
+        goto cleanup_unlock;
+    }
+    /* Allocate a new array */
+    arr = calloc(count, sizeof(*arr));
+    SR_CHECK_MEM_GOTO(!arr, err_info, cleanup_unlock);
+
+    shm_sub = (sr_mod_change_sub_t *)(conn->ext_shm.addr + mod->shm_mod->change_sub[ds].subs);
+
+    for (i = 0; i < count; i++) {
+        if (shm_sub->xpath && (shm_sub->opts & SR_SUBSCR_PRODUCER_FILTERING)) {
+            if (sr_shmsub_change_filter_is_valid(conn->ext_shm.addr + shm_sub->xpath, mod_info->diff)) {
+                arr[i] = shm_sub->xpath_id;
+                xpath_count++;
+            }
+        } else {
+            arr[i] = shm_sub->xpath_id;
+            xpath_count++;
+        }
+        shm_sub++;
+    }
+
+    /* EXT READ UNLOCK */
+    sr_shmext_conn_remap_unlock(conn, SR_LOCK_READ, 0, __func__);
+
+    if (xpath_count == 0) {
+        /* No one is interested in this diff, free up indices here itself */
+        goto cleanup;
+    }
+
+    /* Create a list of xpath_ids that are interested in this diff */
+    xpath_arr = malloc(xpath_count * sizeof(*xpath_arr));
+    SR_CHECK_MEM_GOTO(!xpath_arr, err_info, cleanup);
+
+    for (i = 0; i < count; i++) {
+        if (arr[i]) {
+            xpath_arr[j++] = arr[i];
+        }
+    }
+    mod->filtered_indices = arr;
+    mod->xpath_ids = xpath_arr;
+    mod->xpath_id_count = xpath_count;
+
+    /* Success */
+    return NULL;
+
+cleanup_unlock:
+      sr_shmext_conn_remap_unlock(conn, SR_LOCK_READ, 0, __func__);
+cleanup:
+    if ((xpath_count == 0) || err_info) {
+        /* If there are no xpaths or if an error happened free up */
+        free(arr);
+    }
+
+    return err_info;
+}
+
+/**
+ * Given an index of a change subscription, evaluate if the subscription must be notified
+ * of the specified change.
+ * Additionally do a connection alive check if requested.
+ * Two checks are performed
+ * 1. if event is relevant to the subscription
+ * 2. if producer filtering is opted for and xpath matches diff
+ *
+ * Note: connection ext remap read lock must be held during this call
+ * @return
+ * -1 if connection is dead
+ *  0 if change is not relevant to this subscriber
+ *  1 if change is relevant to this subscriber
+ */
+static int
+sr_shmsub_change_check_index_relevance(struct sr_mod_info_s *mod_info, struct sr_mod_info_mod_s *mod,
+        uint32_t index, sr_sub_event_t ev, int do_conn_check)
+{
+    sr_error_info_t *err_info = NULL;
+    sr_datastore_t ds = mod_info->ds;
+    sr_conn_ctx_t *conn = mod_info->conn;
+    sr_mod_change_sub_t *shm_sub = (sr_mod_change_sub_t *)
+        (conn->ext_shm.addr + mod->shm_mod->change_sub[ds].subs) + index;
+
+    if (!mod->filtered_indices) {
+        sr_errinfo_new(&err_info, SR_ERR_INTERNAL, "xpath filtering indices cannot be NULL here");
+        return 0;
+    }
+    if (do_conn_check) {
+        /* check subscription aliveness */
+        if (!sr_conn_is_alive(shm_sub->cid)) {
+            /* Update xpath_ids by removing index as its CID is dead */
+            sr_shmsub_update_xpath_ids(mod, index, mod->shm_mod->change_sub[ds].sub_count);
+            return -1;
+        }
+    }
+
+    /* Event relevance check */
+    if (!sr_shmsub_change_listen_event_is_valid(ev, shm_sub->opts)) {
+        return 0;
+    }
+
+    /* Diff relevance check */
+    if (mod->xpath_id_count) {
+        return mod->filtered_indices[index] != 0;
+    }
+    return 0;
+}
