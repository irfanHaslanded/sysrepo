+static void
+sr_rwlock_reader_del_dirty(sr_rwlock_t *rwlock, sr_cid_t cid)
+{
+    SR_RWLOCK_WRN(rwlock, SR_LOCK_READ, cid, __func__, "deleting");
+    sr_error_info_t *err_info = NULL;
+    uint64_t expected = 0, new;
+    uint32_t result = 0, iter = 0;
+    uint32_t i;
+
+    /* arbitrary try 100 times to do this */
+    while (iter++ < 100 && !result) {
+
+        /* Look for our cid */
+        for (i = 0; (i < SR_RWLOCK_READ_LIMIT) && SR_RWLOCK_RD_CID(rwlock, i) && (SR_RWLOCK_RD_CID(rwlock, i) != cid); ++i);
+
+        if (i == SR_RWLOCK_READ_LIMIT) {
+            /* maybe someone moved us up while we were traversing, look again */
+            usleep(10000);
+            continue;
+        }
+
+        /* found our cid */
+        expected = SR_RWLOCK_READER(rwlock, i);
+        if (SR_RWLOCK_CID(expected) == cid) {
+            new = expected - 1;
+            assert((new & UINT32_MAX) < UINT8_MAX);
+            ATOMIC_COMPARE_EXCHANGE_RELAXED(rwlock->readers[i], expected, new, result);
+            /* if we fail, we start over again*/
         }
-        ++rwlock->read_count[i];
     }
 
-cleanup:
-    return err_info;
+    if (!result) {
+        SR_RWLOCK_WRN(rwlock, SR_LOCK_READ, cid, __func__, "CID not found");
+        SR_ERRINFO_INT(&err_info);
+        sr_errinfo_free(&err_info);
+        abort();
+    }
+
+    result = ATOMIC_DEC_RELAXED(rwlock->read_count);
+    assert(result);
 }
 
