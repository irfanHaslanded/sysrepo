-sr_rwlock_reader_del_(sr_rwlock_t *rwlock, uint32_t i)
+sr_rwlock_reader_del_(sr_rwlock_t *rwlock, uint32_t del, uint32_t dead)
 {
-    /* decrease recursive read lock count */
-    assert(rwlock->read_count[i]);
-    --rwlock->read_count[i];
+    uint32_t rd_count = SR_RWLOCK_RD_COUNT(rwlock, del);
+    uint64_t expected;
+    uint32_t i, last = 0;
+    int ret;
 
-    if (rwlock->read_count[i]) {
-        /* read lock is still recursively held */
-        return;
+    /* rd_count can be zero in case of a dirty delete */
+    if (rd_count) {
+        /* decrease recursive read lock count */
+        rd_count = SR_RWLOCK_RD_DEC(rwlock, del);
     }
 
-    /* move all the following CIDs so that there are no holes */
-    while ((i < (SR_RWLOCK_READ_LIMIT - 1)) && rwlock->readers[i + 1]) {
-        rwlock->readers[i] = rwlock->readers[i + 1];
-        rwlock->read_count[i] = rwlock->read_count[i + 1];
-        ++i;
-    }
+    assert(dead || rd_count >= 1);
 
-    /* remove the last CID */
-    rwlock->readers[i] = 0;
-    rwlock->read_count[i] = 0;
+    /* no more readers of this cid or dead, so remove it fully */
+    if (rd_count == 1 || dead) {
+        SR_RWLOCK_RD_CLEAR(rwlock, del);
+
+        /* check if the list is full */
+        i = SR_RWLOCK_READ_LIMIT - 1;
+        if (SR_RWLOCK_RD_CID(rwlock, i)) {
+            last = i;
+        } else {
+            /* find the last reader in the list */
+            for (i = del + 1; i < SR_RWLOCK_READ_LIMIT && SR_RWLOCK_RD_CID(rwlock, i); i++) {
+                last = i;
+            }
+        }
+
+        if (last) {
+            ret = 0;
+            /* atomically learn and clear last one so a dirty deleter doesn't obsolete index */
+            while (!ret) {
+                expected = SR_RWLOCK_READER(rwlock, last);
+                assert(expected);
+                ATOMIC_COMPARE_EXCHANGE_RELAXED(rwlock->readers[last], expected, 0llu, ret);
+            }
+            assert(expected);
+            ATOMIC_STORE_RELAXED(rwlock->readers[del], expected);
+        }
+    }
+    if (dead) {
+        rd_count = ATOMIC_SUB_RELAXED(rwlock->read_count, rd_count);
+    } else {
+        rd_count = ATOMIC_DEC_RELAXED(rwlock->read_count);
+    }
+    assert(rd_count);
 }
 
