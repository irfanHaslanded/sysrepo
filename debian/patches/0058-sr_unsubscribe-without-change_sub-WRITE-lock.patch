+static void
+test_create_subscr_and_die(void)
+{
+    int ret;
+    sr_conn_ctx_t *conn = NULL;
+    sr_session_ctx_t *sess = NULL;
+    sr_subscription_ctx_t *subscr = NULL;
+    cb_stats stats = {0};
+
+    /* set up an operational change_sub and exit */
+    ret = sr_connect(0, &conn);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_session_start(conn, SR_DS_OPERATIONAL, &sess);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_module_change_subscribe(sess, "test", "/test:l1", module_change_cb, &stats,
+                0, SR_SUBSCR_NO_THREAD, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_module_change_subscribe(sess, "test", "/test:l1", module_change_cb, &stats,
+                0, SR_SUBSCR_NO_THREAD, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+    TLOG_INF("subscriptions setup with no thread, so publisher will have to wait");
+
+    ret = sr_set_item_str(sess, "/test:test-leaf", "1", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_apply_changes(sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    sleep(1);
+    TLOG_INF("dirty exit");
+    exit(0);
+}
+
+static void
+test_subscr_dirty_exit(void **arg)
+{
+    struct state *st = (struct state *)*arg;
+    int ret;
+    sr_data_t *data = NULL;
+
+    if (!fork()) {
+        /* child process */
+        test_create_subscr_and_die();
+    }
+
+    sr_session_start(st->conn, SR_DS_OPERATIONAL, &st->sess);
+    TLOG_INF("wait for subscriptions to be setup");
+
+    while (sr_get_node(st->sess, "/test:test-leaf", 0, &data) != SR_ERR_OK) {
+        usleep(10000);
+    }
+    sr_release_data(data);
+
+    ret = sr_set_item_str(st->sess, "/test:l1[k='interested_key']/v", "25", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_apply_changes(st->sess, 200);
+    assert_int_equal(ret, SR_ERR_CALLBACK_FAILED);
+
+    while (sr_get_node(st->sess, "/test:test-leaf", 0, &data) == SR_ERR_OK) {
+        sr_release_data(data);
+        usleep(10000);
+    }
+
+    ret = sr_set_item_str(st->sess, "/test:l1[k='interested_key']/v", "25", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_delete_item(st->sess, "/test:l1[k='interested_key']/v", 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(st->sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+}
+
+static void *
+test_make_changes_helper(void *arg)
+{
+    struct state *st = (struct state *)arg;
+    int ret;
+    /* create and delete slow subscriptions and suspend few of them */
+    sr_session_ctx_t *sess = NULL;
+    sr_session_start(st->conn, SR_DS_OPERATIONAL, &sess);
+    ATOMIC_STORE_RELAXED(st->invocation_count, 0);
+
+    pthread_barrier_wait(&st->barrier);
+
+    while (ATOMIC_LOAD_RELAXED(st->running)) {
+        sched_yield();
+
+        ret = sr_set_item_str(sess, "/test:l1[k='interested_key']/v", "25", NULL, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_apply_changes(sess, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ATOMIC_INC_RELAXED(st->invocation_count);
+        ret = sr_delete_item(sess, "/test:l1[k='interested_key']/v", 0);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        ret = sr_apply_changes(sess, 0);
+        assert_int_equal(ret, SR_ERR_OK);
+        ATOMIC_INC_RELAXED(st->invocation_count);
+    }
+
+    ret = sr_session_stop(sess);
+    assert_int_equal(ret, SR_ERR_OK);
+    return NULL;
+}
+
+static void
+test_subscr_suspend(void **arg)
+{
+    int NUM_ITERS = test_full_scale ? 10000 : 10;
+
+    struct state *st = (struct state *)*arg;
+    int i, j, ret;
+    pthread_t tid;
+    sr_subscription_ctx_t *subscr[4] = {NULL};
+    cb_stats stats[4] = {0};
+    cb_stats susp_stats = {0};
+    uint32_t sub_id;
+
+    /* launch a thread that keeps pushing changes */
+    pthread_create(&tid, NULL, test_make_changes_helper, st);
+
+    sr_session_start(st->conn, SR_DS_OPERATIONAL, &st->sess);
+
+    memset(subscr, 0, sizeof(subscr));
+    ret = sr_module_change_subscribe(st->sess, "test", NULL, module_change_cb, &susp_stats,
+            0, 0, &subscr[0]);
+    assert_int_equal(ret, 0);
+    sub_id = sr_subscription_get_last_sub_id(subscr[0]);
+
+    for (j = 0; j < 4; j++) {
+        ret = sr_module_change_subscribe(st->sess, "test", NULL, module_change_cb, &stats[j],
+                0, 0, &subscr[j]);
+        assert_int_equal(ret, 0);
+    }
+    /* wait for subscr threads to be launched */
+    pthread_barrier_wait(&st->barrier);
+    for (i = 0; i < NUM_ITERS; i++) {
+        ret = sr_subscription_suspend(subscr[0], sub_id);
+        assert_int_equal(ret, 0);
+        ret = sr_subscription_resume(subscr[0], sub_id);
+        assert_int_equal(ret, 0);
+    }
+
+    ATOMIC_STORE_RELAXED(st->running, 0);
+    pthread_join(tid, NULL);
+
+    /* check that invocation_count is met for all stats */
+
+    assert_int_equal(ret, SR_ERR_OK);
+    for (j = 0; j < 4; j++) {
+        assert_int_equal(ATOMIC_LOAD_RELAXED(stats[j].count), 2*ATOMIC_LOAD_RELAXED(st->invocation_count));
+    }
+
+    for (j = 0; j < 4; j++) {
+        ret = sr_unsubscribe(subscr[j]);
+        assert_int_equal(ret, 0);
+    }
+}
+
+static void
+test_subscr_scrap(void **arg)
+{
+    int NUM_ITERS = test_full_scale ? 20 : 4;
+    struct state *st = (struct state *)*arg;
+    int i, j, ret, priority;
+    pthread_t tid;
+    sr_subscription_ctx_t *subscr[4] = {NULL};
+
+    /* make callbacks sleep and be slow */
+    cb_stats stats[4] = {{0, 100000}, {0, 100000}, {0, 100000}, {0, 100000}};
+    cb_stats susp_stats = { 0, 100000};
+
+    /* launch a thread that keeps pushing changes */
+    pthread_create(&tid, NULL, test_make_changes_helper, st);
+
+    sr_session_start(st->conn, SR_DS_OPERATIONAL, &st->sess);
+
+    for (i = 0; i < NUM_ITERS; i++) {
+        priority=0;
+        memset(subscr, 0, sizeof(subscr));
+        ret = sr_module_change_subscribe(st->sess, "test", NULL, module_change_cb, &susp_stats,
+                priority, 0, &subscr[0]);
+        assert_int_equal(ret, 0);
+
+        for (j = 0; j < 4; j++) {
+            ret = sr_module_change_subscribe(st->sess, "test", NULL, module_change_cb, &stats[j],
+                    priority++%2, 0, &subscr[j]);
+            assert_int_equal(ret, 0);
+        }
+
+        /* wait for subscr threads to be launched the first time */
+        if (!i) pthread_barrier_wait(&st->barrier);
+        usleep(100000);
+        TLOG_INF("starting unsubscribe iter %d", i+1);
+        for (j = 0; j < 4; j++) {
+            ret = sr_unsubscribe(subscr[j]);
+            assert_int_equal(ret, 0);
+        }
+        TLOG_INF("finished unsubscribe iter %d", i+1);
+        memset(stats, 0, sizeof stats);
+        if (i == NUM_ITERS-2) {
+            ATOMIC_STORE_RELAXED(st->running, 0);
+            pthread_join(tid, NULL);
+        }
+    }
+}
