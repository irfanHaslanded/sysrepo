+static void
+print_all_changes(sr_session_ctx_t *session, sr_change_iter_t *iter)
+{
+    const char *op_str[] = {"created", "modified", "deleted", "moved"};
+    sr_change_oper_t op;
+    sr_val_t *old_val = NULL, *new_val = NULL;
+    int ret;
+    while (1) {
+        op = -1;
+        old_val = new_val = NULL;
