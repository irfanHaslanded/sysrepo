From: IrfanMohammad <irfan@graphiant.com>
Date: Wed, 13 Mar 2024 15:54:04 +0000
Subject: Revert libyang err msg changes

This reverts f04900891d17e3fd5a9634971c3a34a0c7c43b9f
---
 src/ly_wrap.c           | 5 ++++-
 tests/test_notif.c      | 6 +++---
 tests/test_rpc_action.c | 4 ++--
 3 files changed, 9 insertions(+), 6 deletions(-)

diff --git a/src/ly_wrap.c b/src/ly_wrap.c
index abdd81b..f6d607a 100644
--- a/src/ly_wrap.c
+++ b/src/ly_wrap.c
@@ -48,6 +48,7 @@ sr_errinfo_new_ly(sr_error_info_t **err_info, const struct ly_ctx *ly_ctx, const
 {
     const struct ly_err_item *e = NULL;
     const struct lyd_node *node;
+    const char *path = NULL, *path_type = NULL;
 
     if (ly_ctx) {
         e = ly_err_first(ly_ctx);
@@ -81,7 +82,9 @@ sr_errinfo_new_ly(sr_error_info_t **err_info, const struct ly_ctx *ly_ctx, const
             assert(e->level == LY_LLERR);
             /* store it and print it */
             if (e->data_path || e->schema_path) {
-                sr_errinfo_new(err_info, err_code, "%s (path \"%s\")", e->msg, e->data_path ? e->data_path : e->schema_path);
+                path_type = e->data_path ? "Data" : "Schema";
+                path =  e->data_path ? e->data_path : e->schema_path;
+                sr_errinfo_new(err_info, err_code, "%s (%s location \"%s\".)", e->msg, path_type, path);
             } else {
                 sr_errinfo_new(err_info, err_code, "%s", e->msg);
             }
