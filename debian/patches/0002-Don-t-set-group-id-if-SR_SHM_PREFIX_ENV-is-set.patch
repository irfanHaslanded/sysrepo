From: Irfan Mohammad <irfan@graphiant.com>
Date: Sat, 10 Dec 2022 03:55:12 +0000
Subject: Don't set group id if SR_SHM_PREFIX_ENV is set

Fix the use of sysrepo in unit test environments when SYSREPO_GROUP is
set by detecting when the shared memory prefix is set to be different
from the default (via environment variable) and not attempting to
change the group of data files in this case.
---
 src/common.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/common.c b/src/common.c
index a41a254..6ef6c43 100644
--- a/src/common.c
+++ b/src/common.c
@@ -5712,7 +5712,7 @@ sr_is_prod_env(void)
     static int sr_prod_env = -1;
 
     if (sr_prod_env < 0) {
-        sr_prod_env = !getenv("SR_ENV_RUN_TESTS");
+        sr_prod_env = !getenv("SR_ENV_RUN_TESTS") && !getenv(SR_SHM_PREFIX_ENV);
     }
     return sr_prod_env;
 }
