+static void *
+test_subscr_add_del(void *arg)
+{
+    struct state *st = (struct state *)arg;
+    sr_session_ctx_t *sess = NULL;
+    sr_subscription_ctx_t *subscr = NULL;
+    sr_subscription_ctx_t *subscr2 = NULL;
+    cb_stats stats = {0};
+    sr_subscr_options_t opts = SR_SUBSCR_PRODUCER_FILTERING;
+    int ret, i;
+    char xpath[128] = "";
+
+    sr_session_start(st->conn, SR_DS_RUNNING, &sess);
+
+    ret = sr_module_change_subscribe(sess, "ietf-interfaces", NULL, module_update_cb, &stats,
+            0, opts, &subscr2);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_module_change_subscribe(sess, "test", "/test:l1[k='interested_key']", module_update_cb, &stats,
+            0, SR_SUBSCR_UPDATE | opts, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_module_change_subscribe(sess, "test", "/test:l1[k='other_key']", module_change_cb, &stats,
+            0, opts, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_module_change_subscribe(sess, "test", NULL, module_change_cb, &stats,
+            0, opts, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    pthread_barrier_wait(&st->barrier);
+
+    while (ATOMIC_LOAD_RELAXED(st->running)) {
+        sched_yield();
+        /* Adding a lot of subscribers to force remap of shm_ext */
+        for (i = 0; i < 100; i++) {
+            sprintf(xpath, "/ietf-interfaces:interfaces/interface[name='eth%d']/type", i);
+            ret = sr_module_change_subscribe(sess, "ietf-interfaces", xpath, module_change_cb, &stats,
+                    0, opts, &subscr2);
+            assert_int_equal(ret, SR_ERR_OK);
+        }
+        sched_yield();
+        ret = sr_unsubscribe(subscr2);
+        subscr2 = NULL;
+        assert_int_equal(ret, SR_ERR_OK);
+    }
+    ret = sr_unsubscribe(subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    return NULL;
+}
