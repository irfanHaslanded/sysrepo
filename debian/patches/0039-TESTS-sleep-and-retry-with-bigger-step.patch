From: IrfanMohammad <irfan@graphiant.com>
Date: Mon, 31 Jul 2023 15:54:59 +0000
Subject: TESTS sleep and retry with bigger step

 sleep of 10ms and retry is too aggressive, and the scheduler may
 not always get around scheduling the correct thread, when busy.
---
 tests/CMakeLists.txt       |  2 +-
 tests/test_apply_changes.c | 73 ++++++++++++++++++++++++----------------------
 tests/test_lock_log.c      |  2 +-
 3 files changed, 40 insertions(+), 37 deletions(-)

diff --git a/tests/CMakeLists.txt b/tests/CMakeLists.txt
index c80db1e..03af25a 100644
--- a/tests/CMakeLists.txt
+++ b/tests/CMakeLists.txt
@@ -125,7 +125,7 @@ endif()
 # valgrind tests
 if(ENABLE_VALGRIND_TESTS)
     foreach(test_name IN LISTS tests)
-        add_test(NAME ${test_name}_valgrind COMMAND valgrind --malloc-fill=0xED --free-fill=0xBF --leak-check=full --show-leak-kinds=all --suppressions=${CMAKE_SOURCE_DIR}/tests/mongoc_init.supp --error-exitcode=1 ${CMAKE_BINARY_DIR}/tests/${test_name})
+        add_test(NAME ${test_name}_valgrind COMMAND valgrind --track-origins=yes --num-callers=24 --malloc-fill=0xED --free-fill=0xBF --leak-check=full --show-leak-kinds=all --suppressions=${CMAKE_SOURCE_DIR}/tests/mongoc_init.supp --error-exitcode=1 ${CMAKE_BINARY_DIR}/tests/${test_name})
         set(test_name "${test_name}_valgrind")
         set_property(TEST ${test_name} APPEND PROPERTY ENVIRONMENT
             "SYSREPO_REPOSITORY_PATH=${PROJECT_BINARY_DIR}/test_repositories/${test_name}"
