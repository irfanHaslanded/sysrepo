-    }
+    sr_cid_t cid, upgr = 0;
 
     /* read-upgr */
     if (rwlock->upgr) {
@@ -2479,6 +2567,7 @@ sr_rwlock_recover(sr_rwlock_t *rwlock, const char *func, sr_lock_recover_cb cb,
