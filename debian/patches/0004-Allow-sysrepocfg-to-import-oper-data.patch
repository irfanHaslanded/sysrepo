diff --git a/tests/test_sysrepocfg_oper.sh b/tests/test_sysrepocfg_oper.sh
new file mode 100755
index 0000000..35cebef
--- /dev/null
+++ b/tests/test_sysrepocfg_oper.sh
@@ -0,0 +1,31 @@
+#!/bin/sh
+set -e
+set -x
+pwd
+ctl='./sysrepoctl'
+cfg='./sysrepocfg'
+cat << EOF > oper.json
+{
+  "mixed-config:test-state": {
+    "ll": [
+      "val1"
+    ]
+  }
+}
+EOF
+
+$ctl -v3 -i ../tests/files/mixed-config.yang
+$cfg -v3 -Ioper.json -d operational -m mixed-config &
+
+# wait for oper data to be set up
+sleep 1
+$cfg -v3 -X -d operational -m mixed-config > out.json
+
+kill -15 $! # SIGTERM
+
+$ctl -u mixed-config
+
+diff out.json oper.json
+result=$?
+rm -f out.json oper.json
+exit $result
