     }
+
+    /* readers */
+    while (i < SR_RWLOCK_READ_LIMIT) {
+        cid = SR_RWLOCK_RD_CID(rwlock, i);
+
+        if (cid && (cid == upgr || !sr_conn_is_alive(cid))) {
+            /* remove the dead reader */
+            sr_rwlock_reader_del_(rwlock, i, 1);
+            SR_RWLOCK_WRN(rwlock, SR_LOCK_READ, cid, func, "recovered");
+            /* recover */
+            if (cb) {
+                cb(SR_LOCK_READ, cid, cb_data);
+            }
+            SR_LOG_WRN("Recovered a read-lock of CID %" PRIu32 " (%s).", cid, func);
+        } else {
+            i++;
+        }
+    }
+}
