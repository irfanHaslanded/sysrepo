+int
+sr_mutex_clocklock(sr_rwlock_t *rwlock, struct timespec *timeout_abs, sr_lock_mode_t mode, sr_cid_t cid, const char *func)
+{
+    int ret;
+    struct timespec now;
+    clock_gettime(COMPAT_CLOCK_ID, &now);
+
+    while (now.tv_sec + SR_COND_RETRY_STEP_SEC < timeout_abs->tv_sec) {
+        now.tv_sec +=  SR_COND_RETRY_STEP_SEC;
+        ret = pthread_mutex_clocklock(&rwlock->mutex, COMPAT_CLOCK_ID, &now);
+        if (!ret || ret != ETIMEDOUT) {
+            return ret;
+        }
+        SR_RWLOCK_WRN(rwlock, mode, cid, func, "delay mutex");
+    }
+
+    return pthread_mutex_clocklock(&rwlock->mutex, COMPAT_CLOCK_ID, timeout_abs);
+}
+
+
+int
+sr_cond_clockwait_retry(sr_cond_t *cond, pthread_mutex_t *mutex, struct timespec *timeout_abs)
+{
+    int ret;
+    struct timespec now;
+    clock_gettime(COMPAT_CLOCK_ID, &now);
+    if (now.tv_sec + SR_COND_RETRY_STEP_SEC >= timeout_abs->tv_sec) {
+        return sr_cond_clockwait(cond, mutex, COMPAT_CLOCK_ID, timeout_abs);
+    } else {
+        now.tv_sec +=  SR_COND_RETRY_STEP_SEC;
+        ret = sr_cond_clockwait(cond, mutex, COMPAT_CLOCK_ID, &now);
+        return ret == ETIMEDOUT ? EAGAIN : ret;
+    }
+}
+
