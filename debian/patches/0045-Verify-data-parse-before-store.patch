From: IrfanMohammad <irfan@graphiant.com>
Date: Tue, 22 Aug 2023 11:59:21 +0000
Subject: Verify data parse before store

If due to any reason, bad data is written into a datastore, it is not
recoverable until we reboot the system. In that case it is better to not
have written it.

Dump the failed datastore file to .failed file for debugging
---
 src/plugins/ds_json.c | 89 +++++++++++++++++++++++++++++++++++++++++++++++----
 1 file changed, 83 insertions(+), 6 deletions(-)

diff --git a/src/plugins/ds_json.c b/src/plugins/ds_json.c
index 15d48da..ccf653e 100644
--- a/src/plugins/ds_json.c
+++ b/src/plugins/ds_json.c
@@ -45,16 +45,70 @@ static sr_error_info_t *srpds_json_load(const struct lys_module *mod, sr_datasto
 static sr_error_info_t * srpds_json_access_get(const struct lys_module *mod, sr_datastore_t ds, void *plg_data,
         char **owner, char **group, mode_t *perm);
 
+static void
+srpds_json_store_failed(struct iovec *iov, const char *path)
+{
+    int fd;
+    char *fail_path = NULL;
+    int ret = asprintf(&fail_path, "%s.failed", path);
+
+    SRPLG_LOG_INF(srpds_name, "Dumping failed for %s", path);
+    if (ret < 0) {
+        return;
+    }
+
+    SRPLG_LOG_INF(srpds_name, "Dumping to %s", fail_path);
+    fd = srpjson_open(srpds_name, fail_path, O_CREAT | O_WRONLY, 00600);
+    if (fd < 0) {
+        goto cleanup;
+    }
+    SRPLG_LOG_INF(srpds_name, "Opened %s", fail_path);
+
+    if (ftruncate(fd, 0) < 0) {
+        goto cleanup;
+    }
+
+    SRPLG_LOG_INF(srpds_name, "Truncated %s", fail_path);
+    if (srpjson_writev(srpds_name, fd, iov, 1)) {
+        goto cleanup;
+    }
+    SRPLG_LOG_INF(srpds_name, "Written %s", fail_path);
+
+cleanup:
+    if (fd > 0) {
+        close(fd);
+    }
+    free(fail_path);
+}
+
 static sr_error_info_t *
 srpds_json_store_(const struct lys_module *mod, sr_datastore_t ds, const struct lyd_node *mod_data, const char *owner,
         const char *group, mode_t perm, int make_backup)
 {
+    int rc;
     sr_error_info_t *err_info = NULL;
     struct stat st;
     struct ly_out *out = NULL;
     char *path = NULL, *bck_path = NULL;
     int fd = -1, backup = 0, creat = 0;
-    uint32_t print_opts;
+    uint32_t print_opts, parse_opts;
+    struct iovec iov;
+
+    struct lyd_node *read_back = NULL;
+    char *str = NULL;
+
+    /* set parse options */
+    parse_opts = LYD_PARSE_ONLY | LYD_PARSE_ORDERED;
+    if (ds == SR_DS_OPERATIONAL) {
+      /* edit may include opaque nodes */
+      parse_opts |= LYD_PARSE_OPAQ;
+    } else {
+      parse_opts |= LYD_PARSE_STRICT;
+    }
+    if ((ds == SR_DS_RUNNING) || (ds == SR_DS_STARTUP) || (ds == SR_DS_FACTORY_DEFAULT)) {
+      /* always valid datastores */
+      parse_opts |= LYD_PARSE_WHEN_TRUE | LYD_PARSE_NO_NEW;
+    }
 
     /* get path */
     if ((err_info = srpjson_get_path(srpds_name, mod->name, ds, &path))) {
@@ -123,7 +177,7 @@ srpds_json_store_(const struct lys_module *mod, sr_datastore_t ds, const struct
     }
 
     /* create out handler */
-    if (ly_out_new_fd(fd, &out)) {
+    if (ly_out_new_memory(&str, 0, &out)) {
         err_info = srpjson_log_err_ly(srpds_name, NULL);
         goto cleanup;
     }
@@ -135,15 +189,38 @@ srpds_json_store_(const struct lys_module *mod, sr_datastore_t ds, const struct
         srplg_log_errinfo(&err_info, srpds_name, NULL, SR_ERR_INTERNAL, "Failed to store data into \"%s\".", path);
         goto cleanup;
     }
+    iov.iov_base = str;
+    iov.iov_len = ly_out_printed(out);
 
-    /* truncate the file to the exact size (to get rid of possible following old data) */
-    if (ftruncate(fd, ly_out_printed(out)) == -1) {
-        srplg_log_errinfo(&err_info, srpds_name, NULL, SR_ERR_SYS, "Failed to truncate \"%s\" (%s).", path,
-                strerror(errno));
+    if (mod_data) {
+        rc = lyd_parse_data_mem(LYD_CTX(mod_data), str, LYD_JSON, parse_opts, 0, &read_back);
+        lyd_free_all(read_back);
+        if (rc) {
+            err_info = srpjson_log_err_ly(srpds_name, LYD_CTX(mod_data));
+            srplg_log_errinfo(&err_info, srpds_name, NULL, SR_ERR_INTERNAL, "Failed to read back data to be stored for mod %s", mod->name);
+
+            /* Dump it to logs */
+            srpds_json_store_failed(&iov, path);
+            goto cleanup;
+        }
+    }
+
+    if (ftruncate(fd, iov.iov_len) == -1) {
+         srplg_log_errinfo(&err_info, srpds_name, NULL, SR_ERR_SYS, "Failed to truncate \"%s\" (%s).", path,
+                 strerror(errno));
+         goto cleanup;
+     }
+
+    /* dump str to fd */
+    if (srpjson_writev(srpds_name, fd, &iov, 1)) {
+        err_info = srpjson_log_err_ly(srpds_name, LYD_CTX(mod_data));
+        srplg_log_errinfo(&err_info, srpds_name, NULL, SR_ERR_INTERNAL, "Failed to store data into \"%s\".", path);
         goto cleanup;
     }
 
 cleanup:
+    free(str);
+
     /* delete the backup file */
     if (backup && (unlink(bck_path) == -1)) {
         srplg_log_errinfo(&err_info, srpds_name, NULL, SR_ERR_SYS, "Failed to remove backup \"%s\" (%s).", bck_path,
