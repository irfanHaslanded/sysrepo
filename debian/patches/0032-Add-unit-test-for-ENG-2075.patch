+/* Test for ENG-2075 */
+static void
+print_all_changes(sr_session_ctx_t *session, sr_change_iter_t *iter)
+{
+    const char *op_str[] = {"created", "modified", "deleted", "moved"};
+    sr_change_oper_t op;
+    sr_val_t *old_val = NULL, *new_val = NULL;
+    int ret;
+    while (1) {
+        op = -1;
+        old_val = new_val = NULL;
+        ret = sr_get_change_next(session, iter, &op, &old_val, &new_val);
+        if (ret != SR_ERR_OK) {
+            TLOG_INF("Got ret %d", ret);
+            break;
+        }
+        TLOG_INF("Got op %s", op_str[op]);
+        if (old_val) {
+            TLOG_INF("  old xpath %s", old_val->xpath);
+            sr_free_val(old_val);
+        }
+        if (new_val) {
+            TLOG_INF("  new xpath %s", new_val->xpath);
+            sr_free_val(new_val);
+        }
+    }
+    sr_free_change_iter(iter);
+}
+
+/* TEST */
+static int
+change_iter_cb(sr_session_ctx_t *session, uint32_t sub_id, const char *module_name, const char *xpath, sr_event_t event,
+        uint32_t request_id, void *private_data)
+{
+    struct state *st = (struct state *)private_data;
+    sr_change_oper_t op;
+    sr_change_iter_t *iter = NULL;
+    sr_val_t *old_val = NULL, *new_val = NULL;
+    int ret;
+    const char *filter = "/ietf-interfaces:interfaces/interface";
+
+    (void)sub_id;
+    (void)request_id;
+    (void)xpath;
+
+    assert_string_equal(module_name, "ietf-interfaces");
+
+    switch (ATOMIC_LOAD_RELAXED(st->cb_called)) {
+    case 0:
+        if (ATOMIC_LOAD_RELAXED(st->cb_called) == 0) {
+            assert_int_equal(event, SR_EV_DONE);
+        }
+        TLOG_INF("Using filter %s", filter);
+        /* get changes iter */
+        ret = sr_get_changes_iter(session, filter, &iter);
+        assert_int_equal(ret, SR_ERR_OK);
+        print_all_changes(session, iter);
+
+        ret = sr_get_changes_iter(session, filter, &iter);
+        assert_int_equal(ret, SR_ERR_OK);
+
+        /* 1st change */
+        ret = sr_get_change_next(session, iter, &op, &old_val, &new_val);
+        assert_int_equal(ret, SR_ERR_OK);
+        assert_int_equal(op, SR_OP_DELETED);
+        assert_non_null(old_val);
+        assert_null(new_val);
+        assert_string_equal(old_val->xpath, "/ietf-interfaces:interfaces/interface[name='eth1000']");
+        sr_free_val(old_val);
+
+        /* 2nd change */
+        ret = sr_get_change_next(session, iter, &op, &old_val, &new_val);
+        assert_int_equal(ret, SR_ERR_OK);
+        assert_int_equal(op, SR_OP_CREATED);
+        assert_null(old_val);
+        assert_non_null(new_val);
+        assert_string_equal(new_val->xpath, "/ietf-interfaces:interfaces/interface[name='eth1003']");
+        sr_free_val(old_val);
+        sr_free_val(new_val);
+
+        /* 3rd change */
+        ret = sr_get_change_next(session, iter, &op, &old_val, &new_val);
+        assert_int_equal(ret, SR_ERR_OK);
+        assert_int_equal(op, SR_OP_CREATED);
+        assert_null(old_val);
+        assert_non_null(new_val);
+        assert_string_equal(new_val->xpath, "/ietf-interfaces:interfaces/interface[name='eth1004']");
+        sr_free_val(new_val);
+
+        /* 4th change */
+        ret = sr_get_change_next(session, iter, &op, &old_val, &new_val);
+        assert_int_equal(ret, SR_ERR_OK);
+        assert_int_equal(op, SR_OP_CREATED);
+        assert_null(old_val);
+        assert_non_null(new_val);
+        assert_string_equal(new_val->xpath, "/ietf-interfaces:interfaces/interface[name='eth1005']");
+        sr_free_val(new_val);
+
+        sr_free_change_iter(iter);
+        break;
+    default:
+        break;
+    }
+    ATOMIC_INC_RELAXED(st->cb_called);
+    return 0;
+}
+
+static void
+test_change_iter(void **arg)
+{
+    struct state *st = (struct state *)*arg;
+    sr_session_ctx_t *sess = NULL;
+    sr_subscription_ctx_t *subscr = NULL;
+    int ret;
+
+    ret = sr_session_start(st->conn, SR_DS_RUNNING, &sess);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth999']/type", "iana-if-type:ethernetCsmacd", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1000']/type", "iana-if-type:ethernetCsmacd", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1001']/type", "iana-if-type:ethernetCsmacd", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1002']/type", "iana-if-type:ethernetCsmacd", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_module_change_subscribe(sess, "ietf-interfaces", "/ietf-interfaces:interfaces/interface", change_iter_cb,
+            st, 0, SR_SUBSCR_DONE_ONLY, &subscr);
+    assert_int_equal(ret, SR_ERR_OK);
+    TLOG_INF("Modify 1001, 1002");
+    /* Modify the type of interface */
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1001']/type", "iana-if-type:l3ipvlan", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1002']/type", "iana-if-type:l3ipvlan", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    /* Create 3 new interfaces */
+    TLOG_INF("Create 1003, 1004, 1005");
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1003']/type", "iana-if-type:ethernetCsmacd", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1004']/type", "iana-if-type:ethernetCsmacd", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_set_item_str(sess, "/ietf-interfaces:interfaces/interface[name='eth1005']/type", "iana-if-type:ethernetCsmacd", NULL, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    TLOG_INF("Delete 1000");
+    ret = sr_delete_item(sess, "/ietf-interfaces:interfaces/interface[name='eth1000']", 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    assert_int_equal(st->cb_called, 1);
+
+    ret = sr_delete_item(sess, "/ietf-interfaces:interfaces", 0);
+    assert_int_equal(ret, SR_ERR_OK);
+
+    ret = sr_apply_changes(sess, 0);
+    assert_int_equal(ret, SR_ERR_OK);
+    sr_unsubscribe(subscr);
+    ret = sr_session_stop(sess);
+    assert_int_equal(ret, SR_ERR_OK);
+}
+
 int
 main(void)
 {
     const struct CMUnitTest tests[] = {
+        cmocka_unit_test(test_change_iter),
         cmocka_unit_test(test_subscr_none),
         cmocka_unit_test(test_subscription_filtering),
         cmocka_unit_test(test_multisub_filtering),
