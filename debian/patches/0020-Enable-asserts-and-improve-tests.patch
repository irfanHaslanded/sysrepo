+module graphnos-base-types {
+    yang-version "1.1";
+    namespace "http://graphiant.com/ns/yang/graphnos-base-types";
+    prefix base-types;
+
+    import ietf-yang-types {
+        prefix yang;
+    }
+    import graphnos-yang-revisions {
+        prefix rev;
+    }
+    organization
+      "Graphiant";
+    contact
+      "yang@graphiant.com";
+
+    description
+      "This YANG module contains basic types used in Graphnos.
+
+       Copyright (C) 2021-2022 Graphiant, Inc.
+       All rights reserved.";
+
+    revision 2022-07-21 {
+        description
+          "Initial revision";
+        rev:revision-label 0.1.1;
+    }
+
+    typedef gdi {
+        description
+          "Graphiant Device Identifier (GDI)";
+        type uint32;
+    }
+    typedef goss-id {
+        description
+          "Graphiant OSS Identifier";
+        type uint64;
+    }
+    typedef guuid {
+        description
+          "Graphiant UUID";
+        type yang:uuid;
+    }
+    typedef gslice {
+        description
+          "Graphiant slice.";
+        type uint32;
+    }
+
+    typedef device-role {
+        type enumeration {
+            enum cpe {
+                description
+                  "Customer premises equipment (CPE). Also known as
+                  Edge. A device that customers will connect their
+                  networks to.";
+            }
+            enum core {
+                description
+                  "Graphiant core router. A device that routes packets,
+                  including those carrying customer data to another CPE,
+                  in the Graphiant core network.";
+            }
+            enum tunnel-terminator {
+                description
+                  "Tunnel terminator. A device that resides on the edge
+                  of the GCS/OSS network and terminates the IPsec
+                  tunnels used to carry GCS/OSS management traffic over
+                  the Internet to/from other (non-tunnel-terminator)
+                  GraphNOS nodes. Routes packets into and out of those
+                  IPsec tunnels as required.";
+            }
+            enum odp-server {
+                description
+                  "Object Distribution Protocol server. A device that
+                  acts as a reflector for customer routing and other
+                  forwarding and dynamic policy information.";
+            }
+        }
+        description
+          "Role that a device is operating in.";
+    }
+}
diff --git a/tests/files/graphnos-extensions.yang b/tests/files/graphnos-extensions.yang
new file mode 100644
index 0000000..75d2068
--- /dev/null
+++ b/tests/files/graphnos-extensions.yang
@@ -0,0 +1,44 @@
+module graphnos-extensions {
+    yang-version "1.1";
+    namespace "http://graphiant.com/ns/yang/graphnos-extensions";
+    prefix extensions;
+
+    import graphnos-yang-revisions {
+        prefix rev;
+    }
+
+    organization
+      "Graphiant";
+    contact
+      "yang@graphiant.com";
+
+    description
+      "This YANG module contains extensions used in Graphnos.
+
+       Copyright (C) 2021 Graphiant, Inc.
+       All rights reserved.";
+
+    revision 2021-10-28 {
+        description
+          "Initial revision";
+        rev:revision-label 0.0.1;
+    }
+
+    extension codegen-node-name {
+        description
+          "Takes an argument as a name string.
+           Makes the code generator use the given name for the node.";
+        argument "name";
+    }
+
+    extension codegen-as-type {
+        description
+          "Takes an argument as a type string.
+           Makes the code generator use the given type for the node. The user
+           must ensure that the type is valid and has the correct Rust module
+           path according to its use. Valid on statements that create
+           generated types, such as type, list, container and choice
+           statements";
+        argument "type";
+    }
+}
diff --git a/tests/files/graphnos-interfaces.yang b/tests/files/graphnos-interfaces.yang
new file mode 100644
index 0000000..b161497
--- /dev/null
+++ b/tests/files/graphnos-interfaces.yang
@@ -0,0 +1,254 @@
+module graphnos-interfaces {
+    yang-version 1.1;
+    namespace "https://graphiant.com/ns/yang/graphnos-interfaces";
+    prefix if;
+
+    import ietf-yang-types {
+        prefix yang;
+    }
+    import graphnos-extensions {
+        prefix extensions;
+    }
+
+    organization
+      "Graphiant";
+
+    contact
+      "yang@graphiant.com";
+
+    description
+      "This module is only for testing.";
+
+    revision 2021-05-26 {
+        description
+          "interface-if-index needed for FRIB.";
+    }
+
+    /*
+     * Typedefs
+     */
+    typedef interface-ref {
+        type leafref {
+            path "/if:interfaces/if:interface/if:name";
+        }
+        description
+          "This type is used by data models that need to reference
+           interfaces.";
+    }
+
+    typedef interface-index {
+        type uint32 {
+            range 1..max;
+        }
+        description
+          "This type represents the conceptual interface index.";
+    }
+
+    typedef interface-index-ref {
+        type leafref {
+            path "/if:interfaces/if:interface-operational/if:state/if:index";
+        }
+        description
+          "This type is used by data models that need to reference
+           an operational interface's index.";
+    }
+
+    typedef interface-operational-ref {
+        type leafref {
+            path "/if:interfaces/if:interface-operational/if:name";
+        }
+        description
+          "This type is used by data models that need to reference
+           operational interfaces.";
+    }
+
+    /*
+     * Identities
+     */
+    identity interface-type {
+        description
+          "Base identity from which specific interface types are
+           derived.";
+    }
+
+    identity iana-interface-type {
+        base interface-type;
+        description
+          "This identity is used as a base for all interface types
+           defined in the 'ifType definitions' registry.";
+    }
+
+    identity ethernetCsmacd {
+        base iana-interface-type;
+        description
+          "For all Ethernet-like interfaces, regardless of speed,
+           as per RFC 3635. Definition copied from RFC7224";
+        reference
+          "RFC 3635 - Definitions of Managed Objects for the
+                      Ethernet-like Interface Types";
+    }
+
+    identity softwareLoopback {
+      base iana-interface-type;
+      description
+        "Software loopback interface. Definition copied from RFC7224.";
+    }
+
+    identity ipsecTunnel {
+        base interface-type;
+        description
+          "Base identity for IPsec tunnels.";
+    }
+
+    identity h2hTunnel {
+        base ipsecTunnel;
+        description
+          "Hop-by-hop tunnel, e.g. CPE to Core, Core to Core.";
+    }
+
+    identity e2eTunnel {
+        base ipsecTunnel;
+        description
+          "End-to-end tunnel, e.g. CPE to CPE.";
+    }
+
+    /*
+     * Groupings
+     */
+    // Intended only for internal graphnos-interfaces use
+    grouping interface-list-common-group {
+
+        leaf name {
+            type string;
+            description
+              "The name of the interface.
+               A device MAY restrict the allowed values for this leaf,
+               possibly depending on the type of the interface.
+               For system-controlled interfaces, this leaf is the
+               device-specific name of the interface.
+               If a client tries to create configuration for a
+               system-controlled interface that is not present in the
+               operational state, the server MAY reject the request if
+               the implementation does not support pre-provisioning of
+               interfaces or if the name refers to an interface that can
+               never exist in the system.  A Network Configuration
+               Protocol (NETCONF) server MUST reply with an rpc-error
+               with the error-tag 'invalid-value' in this case.
+               If the device supports pre-provisioning of interface
+               configuration, the 'pre-provisioning' feature is
+               advertised.
+               If the device allows arbitrarily named user-controlled
+               interfaces, the 'arbitrary-names' feature is advertised.
+               For physical interfaces, 'arbitrary-names' are supported on
+               virtual devices but not on physical devices where interfaces
+               are named according to the type and form-factor.
+               When a configured user-controlled interface is created by
+               the system, it is instantiated with the same name in the
+               operational state.
+               A server implementation MAY map this leaf to the ifName
+               MIB object.  Such an implementation needs to use some
+               mechanism to handle the differences in size and characters
+               allowed between this leaf and ifName.  The definition of
+               such a mechanism is outside the scope of this document.";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifName";
+        }
+        leaf description {
+            type string;
+            description
+              "A textual description of the interface.
+               A server implementation MAY map this leaf to the ifAlias
+               MIB object.  Such an implementation needs to use some
+               mechanism to handle the differences in size and characters
+               allowed between this leaf and ifAlias.  The definition of
+               such a mechanism is outside the scope of this document.
+               Since ifAlias is defined to be stored in non-volatile
+               storage, the MIB implementation MUST map ifAlias to the
+               value of 'description' in the persistently stored
+               configuration.";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifAlias";
+        }
+        leaf type {
+            extensions:codegen-node-name "iftype";
+            type identityref {
+                base interface-type;
+            }
+            mandatory true;
+            description
+              "The type of the interface.
+               When an interface entry is created, a server MAY
+               initialize the type leaf with a valid value, e.g., if it
+               is possible to derive the type from the name of the
+               interface.
+               If a client tries to set the type of an interface to a
+               value that can never be used by the system, e.g., if the
+               type is not supported or if the type does not match the
+               name of the interface, the server MUST reject the request.
+               A NETCONF server MUST reply with an rpc-error with the
+               error-tag 'invalid-value' in this case.";
+            reference
+              "RFC 2863: The Interfaces Group MIB - ifType";
+        }
+    }
+
+    /*
+     * Data nodes
+     */
+    container interfaces {
+        description
+          "Interface parameters.";
+
+        list interface {
+            key "name";
+
+            description
+              "The list of intended interface configuration on the device.
+
+               This list is not present in the operational store. Intended
+               configuration which is operationally active on the system
+               can be found under the 'interface' list (which can be found
+               below this node's parent).";
+
+            uses interface-list-common-group;
+        }
+
+        list interface-operational {
+            config false;
+            key "name";
+
+            description
+              "The list of operational interfaces on the device.
+
+               The status of an interface is available in this list in the
+               operational state.  If the configuration of a
+               system-controlled interface cannot be used by the system
+               (e.g., the interface hardware present does not match the
+               interface type), then the configuration is not applied to
+               the system-controlled interface shown in the operational
+               state.  If the configuration of a user-controlled interface
+               cannot be used by the system, the configured interface is
+               not instantiated in the operational state.
+
+               System-controlled interfaces created by the system are
+               always present in this list in the operational state,
+               whether or not they are configured.";
+
+            uses interface-list-common-group;
+
+            container state {
+                config false;
+                description
+                  "The arbitrated interface state representing what is currently
+                   active on the system.";
+
+                leaf index {
+                    type interface-index;
+                    description
+                      "The interface's global numeric index. This differs from
+                       both the dataplane and kernel indexes.";
+                }
+            }
+        }
+    }
+}
diff --git a/tests/files/graphnos-network-instance.yang b/tests/files/graphnos-network-instance.yang
new file mode 100644
index 0000000..7dfe097
--- /dev/null
+++ b/tests/files/graphnos-network-instance.yang
@@ -0,0 +1,107 @@
+module graphnos-network-instance {
+  yang-version 1.1;
+  namespace "https://graphiant.com/ns/yang/graphnos-network-instance";
+  prefix ni;
+
+  import graphnos-interfaces {
+    prefix if;
+  }
+
+  organization
+    "Graphiant";
+
+  contact
+    "yang@graphiant.com";
+
+  description
+    "This module is for testing only and is derived from graphnos-network-instance.";
+
+  revision 2021-08-25 {
+    description "GraphNOS tweaks";
+  }
+
+  typedef instance-index-ref {
+    type leafref {
+      path "/ni:network-instances/ni:network-instance-operational/ni:state/ni:index";
+    }
+    description
+      "This type is used by data models that need to
+       reference an operational network instance's index.";
+  }
+
+  typedef instance-index {
+    type uint32 {
+      // 2^32-2 is the largest value supported by VPP
+      range min..4294967294;
+    }
+    description
+      "This type represents the conceptual network instance index.";
+  }
+
+  // Groupings
+
+  // Intended only for internal graphnos-network-instance use
+  grouping network-instance-list-common-group {
+    leaf name {
+        type string;
+        description
+          "device-scoped identifier for the network
+           instance.";
+      }
+  }
+
+  // top-level device definition statements
+
+  container network-instances {
+    description
+      "Network instances, each of which consists of a VRF";
+    reference
+      "RFC 8349: A YANG Data Model for Routing Management";
+    list network-instance {
+      key "name";
+      description
+        "List of configured network instances.";
+
+      uses network-instance-list-common-group;
+    }
+
+    list network-instance-operational {
+      key "name";
+      description
+        "List of operational network instances.";
+      config false;
+
+      uses network-instance-list-common-group;
+      container state {
+        description
+          "The active state of the network instance.";
+
+        leaf index {
+            type instance-index;
+            mandatory true;
+            description
+              "The network instance's global numeric index.
+               This differs from both the dataplane and kernel indexes.";
+        }
+        leaf status {
+          type enumeration {
+            enum not-ready {
+              description
+                "The network instance is not ready to be used.";
+            }
+            enum ready {
+              description
+                "The system has completed set up of the network instance.";
+            }
+            enum deleting {
+              description
+                "The network instance is pending deletion and should not be used.";
+            }
+          }
+          mandatory true;
+          description "System level state of the network instance.";
+        }
+      }
+    }
+  }
+}
diff --git a/tests/files/graphnos-policy-packet-fields.yang b/tests/files/graphnos-policy-packet-fields.yang
new file mode 100644
index 0000000..194bb76
--- /dev/null
+++ b/tests/files/graphnos-policy-packet-fields.yang
@@ -0,0 +1,307 @@
+module graphnos-policy-packet-fields {
+  yang-version 1.1;
+  namespace "https://graphiant.com/ns/yang/graphnos-policy-packet-fields";
+  prefix packet-fields;
+
+  import ietf-inet-types {
+    prefix inet;
+    reference
+      "RFC 6991 - Common YANG Data Types.";
+  }
+  import graphnos-yang-revisions {
+      prefix rev;
+  }
+
+  organization
+      "Graphiant";
+
+  contact
+      "yang@graphiant.com";
+
+  description
+    "This YANG module defines groupings that are used by
+    graphiant policy YANG module.
+    It is a sub-set of groupings defined in the IETF packet-fields YANG";
+
+  revision 2021-11-24 {
+    description
+      "Initial version.";
+    rev:revision-label 0.0.1;
+  }
+
+  /*
+   * Groupings
+   */
+  grouping port-range-or-exact {
+    description
+      "Grouping for port definitions in the form of a
+       choice statement.";
+    choice port-range-or-exact {
+        description
+            "Choice of specifying a port range or a single port.";
+        container range {
+            leaf lower-port {
+                type inet:port-number;
+                must ". <= ../upper-port" {
+                    error-message
+                        "The lower-port must be less than or equal to
+                           upper-port.";
+                }
+                mandatory true;
+                description
+                    "Lower boundary for a port.";
+            }
+            leaf upper-port {
+                type inet:port-number;
+                mandatory true;
+                description
+                    "Upper boundary for port.";
+            }
+        }
+        container port {
+            leaf port {
+                type inet:port-number;
+                mandatory true;
+                description
+                    "Port number along with operator on which to
+                       match.";
+            }
+        }
+    }
+  }
+
+  grouping ip-header-fields {
+    description
+      "IP header fields common to ipv4 and ipv6";
+    reference
+      "RFC 791: Internet Protocol.";
+
+    leaf protocol {
+      type uint8;
+      description
+        "Internet Protocol number. Refers to the protocol of the
+         payload. In IPv6, this field is known as 'next-header',
+         and if extension headers are present, the protocol is
+         present in the 'upper-layer' header.";
+      reference
+        "RFC 791: Internet Protocol,
+         RFC 8200: Internet Protocol, Version 6 (IPv6) Specification.";
+    }
+    leaf dscp {
+        type inet:dscp;
+        description
+            "Differentiated Services Code Point.";
+        reference
+            "RFC 2474: Definition of the Differentiated Services
+                       Field (DS Field) in the IPv4 and IPv6
+                       Headers.";
+    }
+  }
+
+  grouping ipv4-header-fields {
+      description
+          "Fields in IPv4 header.";
+
+      leaf destination-ipv4-network {
+          description
+              "Destination IPv4 address prefix.";
+          type inet:ipv4-prefix;
+      }
+      leaf source-ipv4-network {
+          description
+              "Source IPv4 address prefix.";
+          type inet:ipv4-prefix;
+      }
+  }
+
+  grouping ipv6-header-fields {
+      description
+          "Fields in IPv6 header";
+
+      leaf destination-ipv6-network {
+          description
+              "Destination IPv6 address prefix.";
+          type inet:ipv6-prefix;
+      }
+      leaf source-ipv6-network {
+          description
+              "Source IPv6 address prefix.";
+          type inet:ipv6-prefix;
+      }
+  }
+
+  grouping tcp-header-fields {
+    description
+      "Collection of TCP header fields that can be used to
+       setup a match filter.";
+
+    leaf sequence-number {
+      description
+        "Sequence number that appears in the packet.";
+      type uint32;
+    }
+
+    leaf acknowledgement-number {
+      description
+        "The acknowledgement number that appears in the
+         packet.";
+      type uint32;
+    }
+
+    leaf data-offset {
+      description
+        "Specifies the size of the TCP header in 32-bit
+         words. The minimum size header is 5 words and
+         the maximum is 15 words thus giving the minimum
+         size of 20 bytes and maximum of 60 bytes,
+         allowing for up to 40 bytes of options in the
+         header.";
+      type uint8 {
+        range "5..15";
+      }
+    }
+
+    leaf reserved {
+      description
+        "Reserved for future use.";
+      type uint8;
+    }
+
+    leaf flags {
+      description
+        "Also known as Control Bits. Contains 9 1-bit flags.";
+      reference
+        "RFC 793: Transmission Control Protocol (TCP).";
+      type bits {
+        bit cwr {
+          position 1;
+          description
+            "Congestion Window Reduced (CWR) flag is set by
+             the sending host to indicate that it received
+             a TCP segment with the ECE flag set and had
+             responded in congestion control mechanism.";
+          reference
+            "RFC 3168: The Addition of Explicit Congestion
+                       Notification (ECN) to IP.";
+        }
+        bit ece {
+          position 2;
+          description
+            "ECN-Echo has a dual role, depending on the value
+             of the SYN flag. It indicates:
+             If the SYN flag is set (1), that the TCP peer is ECN
+             capable. If the SYN flag is clear (0), that a packet
+             with Congestion Experienced flag set (ECN=11) in IP
+             header was received during normal transmission
+             (added to header by RFC 3168). This serves as an
+             indication of network congestion (or impending
+             congestion) to the TCP sender.";
+          reference
+            "RFC 3168: The Addition of Explicit Congestion
+                       Notification (ECN) to IP.";
+        }
+        bit urg {
+          position 3;
+          description
+            "Indicates that the Urgent pointer field is significant.";
+        }
+        bit ack {
+          position 4;
+          description
+            "Indicates that the Acknowledgment field is significant.
+             All packets after the initial SYN packet sent by the
+             client should have this flag set.";
+        }
+        bit psh {
+          position 5;
+          description
+            "Push function. Asks to push the buffered data to the
+             receiving application.";
+        }
+        bit rst {
+          position 6;
+          description
+            "Reset the connection.";
+        }
+        bit syn {
+          position 7;
+          description
+            "Synchronize sequence numbers. Only the first packet
+             sent from each end should have this flag set. Some
+             other flags and fields change meaning based on this
+             flag, and some are only valid for when it is set,
+             and others when it is clear.";
+        }
+        bit fin {
+          position 8;
+          description
+            "Last package from sender.";
+        }
+      }
+    }
+
+    leaf window-size {
+      description
+        "The size of the receive window, which specifies
+         the number of window size units beyond the segment
+         identified by the sequence number in the acknowledgment
+         field that the sender of this segment is currently
+         willing to receive.";
+      type uint16;
+      units "bytes";
+    }
+
+    leaf urgent-pointer {
+      description
+        "This field is an offset from the sequence number
+         indicating the last urgent data byte.";
+      type uint16;
+    }
+
+    leaf options {
+      description
+        "The length of this field is determined by the
+         data offset field. Options have up to three
+         fields: Option-Kind (1 byte), Option-Length
+         (1 byte), Option-Data (variable). The Option-Kind
+         field indicates the type of option, and is the
+         only field that is not optional. Depending on
+         what kind of option we are dealing with,
+         the next two fields may be set: the Option-Length
+         field indicates the total length of the option,
+         and the Option-Data field contains the value of
+         the option, if applicable.";
+      type binary {
+        length "1..40";
+      }
+    }
+  }
+
+  grouping icmp-header-fields {
+    description
+      "Collection of ICMP header fields that can be
+       used to setup a match filter.";
+
+    leaf type {
+      description
+        "Also known as Control messages.";
+      reference
+        "RFC 792: Internet Control Message Protocol (ICMP),
+         RFC 4443: Internet Control Message Protocol (ICMPv6)
+                   for Internet Protocol Version 6 (IPv6)
+                   Specifciation.";
+      type uint8;
+    }
+
+    leaf code {
+      description
+        "ICMP subtype. Also known as Control messages.";
+      reference
+        "RFC 792: Internet Control Message Protocol (ICMP),
+         RFC 4443: Internet Control Message Protocol (ICMPv6)
+                   for Internet Protocol Version 6 (IPv6)
+                   Specifciation.";
+      type uint8;
+    }
+  }
+}
diff --git a/tests/files/graphnos-policy-types.yang b/tests/files/graphnos-policy-types.yang
new file mode 100644
index 0000000..719cf43
--- /dev/null
+++ b/tests/files/graphnos-policy-types.yang
@@ -0,0 +1,175 @@
+module graphnos-policy-types {
+    yang-version 1.1;
+    namespace "https://graphiant.com/ns/yang/graphnos-policy-types";
+    prefix plt;
+
+    import graphnos-yang-revisions {
+        prefix rev;
+    }
+
+    import graphnos-policy-packet-fields {
+        prefix pf;
+    }
+
+    organization
+      "Graphiant";
+
+    contact
+      "yang@graphiant.com";
+
+    description
+      "This module is used to describe Policy types that can be shared between
+       YANG models.";
+
+    revision 2023-01-05 {
+        description
+          "Initial revision.";
+        rev:revision-label 0.2.1;
+    }
+
+    typedef policy-index {
+        type uint32 {
+            range 1..max;
+        }
+        description
+          "This type represents the unique policy index.";
+    }
+
+    typedef policy-priority {
+        description
+          "Priority - lower value has higher priority.";
+        type uint32 {
+           range 1..max;
+        }
+    }
+
+    /* Domain related types. */
+    typedef dp-domain-id {
+        description
+          "A dataplane domain ID identifies a domain in the dataplane.
+           This comprised of a number of components. The lower 2 bits
+           encode the required local edge SLA, the next 2 bits encode
+           the required remote edge SLA, the next 2 bits encode the
+           required service SLA in the case of a service domain.
+           The next 2 bits are reserved for future use. The next 6
+           bits encode the nth combination of attributes and an
+           optional service ID. The remaining 2 bits are reserved for
+           future use.";
+        type uint16 {
+            /* 0x0 to 0x3f3f, i.e. top 2 bits in each byte are unusable
+               with the current encoding scheme. */
+            range 0..16191;
+        }
+    }
+    typedef domain-id {
+        description
+          "A configuration sourced domain identifier. This identifies the domain from the
+           OSS/customer point of view. The value 0 is reserved for the default
+           catch all domain.";
+        type uint32;
+    }
+
+    /* Remote attachment related types. */
+    typedef rat-identifier {
+        description "Identifier for a RAT (remote attachment).";
+        type uint32;
+    }
+
+    grouping application-id {
+        description "An Application ID, which is a 32bit value, split into two
+                     fields. The most significant 8 bits are the engine ID,
+                     the least significant 24 are the app ID.
+                     The same applications, i.e. youtube, may not have the
+                     app-ID across engines.";
+        leaf engine-id {
+            mandatory true;
+            type enumeration {
+                enum policy {
+                    value 6;
+                }
+                enum ipoque {
+                    value 24;
+                }
+            }
+        }
+        leaf app-id {
+            mandatory true;
+            type uint32 {
+                range 1..16777215;
+            }
+        }
+    }
+
+    grouping match-n-tuple-header-only {
+        description "Match on various fields in the packet header";
+        choice l3 {
+            description
+                "Choice of either IPv4 or IPv6 headers";
+            container ipv4 {
+                description
+                    "Rule set that matches IPv4 headers.";
+                uses pf:ip-header-fields;
+                uses pf:ipv4-header-fields;
+            }
+            container ipv6 {
+                description
+                    "Rule set that matches IPv6 headers.";
+                uses pf:ip-header-fields;
+                uses pf:ipv6-header-fields;
+            }
+        }
+        choice l4 {
+            description
+                "Choice of TCP, UDP, or ICMP headers.";
+            container tcp {
+                description
+                    "Rule set that matches TCP headers.";
+                container source-port {
+                    uses pf:port-range-or-exact;
+                    description
+                        "Source port definition from range or
+                                 operator.";
+                }
+                container destination-port {
+                    uses pf:port-range-or-exact;
+                    description
+                        "Destination port definition from range or
+                                 operator.";
+                }
+            }
+            container udp {
+                description
+                    "Rule set that matches UDP headers.";
+                container source-port {
+                    uses pf:port-range-or-exact;
+                    description
+                        "Source port definition from range or
+                                 operator.";
+                }
+                container destination-port {
+                    uses pf:port-range-or-exact;
+                    description
+                        "Destination port definition from range or
+                                 operator.";
+                }
+            }
+            container icmp {
+                uses pf:icmp-header-fields;
+                description
+                    "Rule set that matches ICMP headers.";
+            }
+        }
+    }
+
+    grouping match-n-tuple {
+        description
+          "Match on various fields in the packet header, or the identified Application ID.";
+        uses match-n-tuple-header-only;
+        container application-id {
+            description
+                "Optional Application ID to match against.";
+            presence "Application-ID Match included";
+            uses plt:application-id;
+        }
+    }
+}
diff --git a/tests/files/graphnos-policy.yang b/tests/files/graphnos-policy.yang
new file mode 100644
index 0000000..6d342d3
--- /dev/null
+++ b/tests/files/graphnos-policy.yang
@@ -0,0 +1,99 @@
+
+module graphnos-policy {
+    yang-version 1.1;
+    namespace "https://graphiant.com/ns/yang/graphnos-policy";
+    prefix pl;
+
+    import ietf-inet-types {
+        prefix inet;
+        reference
+          "RFC 6991 - Common YANG Data Types.";
+    }
+    import graphnos-interfaces {
+        prefix if;
+    }
+    import graphnos-network-instance {
+        prefix ni;
+    }
+    import graphnos-routing-types {
+        prefix rt;
+    }
+    import graphnos-yang-revisions {
+        prefix rev;
+    }
+
+    organization
+      "Graphiant";
+
+    contact
+      "yang@graphiant.com";
+
+    description
+      "For testing only!";
+
+    revision 2022-05-30 {
+        description
+          "Initial revision.";
+        rev:revision-label 0.0.1;
+    }
+
+    typedef rat-identifier {
+        description "Identifier for a RAT (remote attachment).";
+        type uint32;
+    }
+    typedef rat-ref {
+        type leafref {
+            path "/pl:remote-attachments/pl:remote-attachment/pl:id";
+        }
+        description
+          "This type is used by data models that need to
+          reference a remote attachment (RAT).";
+    }
+
+    grouping remote-attachment {
+        description
+          "A remote attachment (RAT) encapsulates a remote link and
+           it's associated policy attributes.";
+
+        leaf id {
+            description
+              "A unique ID for this RAT, used to identify a RAT as a
+               path attribute in a FRIB entry.";
+            type rat-identifier;
+        }
+
+        leaf source-cpe-address {
+            description
+              "The ipv6 address of the CPE which originated this RAT.
+               Specified so that returning ICMP packets can be matched
+               to a RAT.";
+            type inet:ipv6-address;
+        }
+
+        leaf mtu {
+            description
+              "The MTU of the RAT link";
+            type uint16;
+        }
+
+        leaf connection-id {
+            description
+              "The connection id of the RAT is used to direct traffic
+               onto the remote link from the local node.";
+            type rt:connection-id;
+        }
+    }
+
+    container remote-attachments {
+        config false;
+        description
+            "A table of RATs.";
+        list remote-attachment {
+            unique "id";
+            key "source-cpe-address connection-id";
+
+            uses remote-attachment;
+        }
+    }
+
+}
diff --git a/tests/files/graphnos-routing-types.yang b/tests/files/graphnos-routing-types.yang
new file mode 100644
index 0000000..4e8313f
--- /dev/null
+++ b/tests/files/graphnos-routing-types.yang
@@ -0,0 +1,413 @@
+module graphnos-routing-types {
+    yang-version "1.1";
+    namespace "http://graphiant.com/ns/yang/graphnos-routing-types";
+    prefix rt-types;
+
+    import graphnos-extensions {
+        prefix graphnos;
+    }
+    import graphnos-yang-revisions {
+        prefix rev;
+    }
+
+    organization
+      "Graphiant";
+    contact
+      "yang@graphiant.com";
+
+    description
+      "This module contains a collection of YANG data types
+       considered generally useful for routing protocols.
+
+       Copyright (c) 2017 IETF Trust and the persons
+       identified as authors of the code.  All rights reserved.
+
+       Redistribution and use in source and binary forms, with or
+       without modification, is permitted pursuant to, and subject
+       to the license terms contained in, the Simplified BSD License
+       set forth in Section 4.c of the IETF Trust's Legal Provisions
+       Relating to IETF Documents
+       (https://trustee.ietf.org/license-info).
+
+       This version of this YANG module is part of RFC 8294; see
+       the RFC itself for full legal notices.";
+
+    revision 2022-07-27 {
+        description
+          "Graphnos.
+
+          Added definition of Route-Origin for L3VPN support.";
+
+        reference
+          "IETF Draft rev 5: Yang Data Model for BGP/MPLS L3 VPNs";
+        rev:revision-label 0.0.2;
+    }
+
+    revision 2022-04-28 {
+        description
+          "Graphnos.
+
+          Added definitions of Route-Target and Route-Distinguisher
+          for L3VPN support.
+
+          Added definition of a connection identifier for use with
+          circuit attribute based forwarding.";
+        reference
+          "IETF Draft rev 5: Yang Data Model for BGP/MPLS L3 VPNs";
+        rev:revision-label 0.0.1;
+    }
+
+    /*** Graphnos path attribute based remote path selection. ***/
+    typedef connection-id {
+        type uint8 {
+            /* A value of zero implies unused. */
+            range "0..15";
+        }
+        description
+          "A connection id used to direct traffic onto a RAT (remote
+           attachment).";
+        reference
+          "See graphnos-policy.yang for further details.";
+    }
+
+    /*** Graphnos versions of prefixes that allows host bits ***/
+    typedef ip-prefix {
+       type union {
+         type ipv4-prefix;
+         type ipv6-prefix;
+       }
+       description
+        "The ip-prefix type represents an IP prefix and is IP
+         version neutral.  The format of the textual representations
+         implies the IP version.";
+    }
+
+    typedef ipv4-prefix {
+       type string {
+         pattern
+            '(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\.){3}'
+          +  '([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])'
+          + '/(([0-9])|([1-2][0-9])|(3[0-2]))';
+       }
+       description
+        "The ipv4-prefix type represents an IPv4 address prefix.
+         The prefix length is given by the number following the
+         slash character and must be less than or equal to 32.
+
+         A prefix length value of n corresponds to an IP address
+         mask that has n contiguous 1-bits from the most
+         significant bit (MSB) and all other bits set to 0.
+
+	 Host bits of the address are allowed to be set.";
+    }
+
+    typedef ipv6-prefix {
+       type string {
+         pattern '((:|[0-9a-fA-F]{0,4}):)([0-9a-fA-F]{0,4}:){0,5}'
+               + '((([0-9a-fA-F]{0,4}:)?(:|[0-9a-fA-F]{0,4}))|'
+               + '(((25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])\.){3}'
+               + '(25[0-5]|2[0-4][0-9]|[01]?[0-9]?[0-9])))'
+               + '(/(([0-9])|([0-9]{2})|(1[0-1][0-9])|(12[0-8])))';
+         pattern '(([^:]+:){6}(([^:]+:[^:]+)|(.*\..*)))|'
+               + '((([^:]+:)*[^:]+)?::(([^:]+:)*[^:]+)?)'
+               + '(/.+)';
+       }
+       description
+        "The ipv6-prefix type represents an IPv6 address prefix.
+         The prefix length is given by the number following the
+         slash character and must be less than or equal to 128.
+
+         A prefix length value of n corresponds to an IP address
+         mask that has n contiguous 1-bits from the most
+         significant bit (MSB) and all other bits set to 0.
+
+	 Host bits of the address are allowed to be set.";
+     }
+
+    /*** Timer related definitions ***/
+    typedef timer-value-seconds16 {
+       type union {
+         type uint16 {
+           range "1..65535";
+         }
+         type enumeration {
+           enum infinity {
+             description
+               "The timer is set to infinity.";
+           }
+           enum not-set {
+             description
+               "The timer is not set.";
+           }
+         }
+       }
+       units "seconds";
+       description
+         "Timer value type, in seconds (16-bit range).";
+    }
+
+    typedef timer-value-seconds32 {
+       type union {
+         type uint32 {
+           range "1..4294967295";
+         }
+         type enumeration {
+           enum infinity {
+             description
+               "The timer is set to infinity.";
+           }
+           enum not-set {
+             description
+               "The timer is not set.";
+           }
+         }
+       }
+       units "seconds";
+       description
+         "Timer value type, in seconds (32-bit range).";
+    }
+
+    typedef route-distinguisher {
+      type string {
+        pattern
+          '(0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|'
+        +     '6[0-4][0-9]{3}|'
+        +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0):(429496729[0-5]|'
+        +     '42949672[0-8][0-9]|'
+        +     '4294967[01][0-9]{2}|429496[0-6][0-9]{3}|'
+        +     '42949[0-5][0-9]{4}|'
+        +     '4294[0-8][0-9]{5}|429[0-3][0-9]{6}|'
+        +     '42[0-8][0-9]{7}|4[01][0-9]{8}|'
+        +     '[1-3][0-9]{9}|[1-9][0-9]{0,8}|0))|'
+        + '(1:((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|'
+        +     '25[0-5])\.){3}([0-9]|[1-9][0-9]|'
+        +     '1[0-9]{2}|2[0-4][0-9]|25[0-5])):(6553[0-5]|'
+        +     '655[0-2][0-9]|'
+        +     '65[0-4][0-9]{2}|6[0-4][0-9]{3}|'
+        +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))|'
+        + '(2:(429496729[0-5]|42949672[0-8][0-9]|'
+        +     '4294967[01][0-9]{2}|'
+        +     '429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|'
+        +     '4294[0-8][0-9]{5}|'
+        +     '429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[01][0-9]{8}|'
+        +     '[1-3][0-9]{9}|[1-9][0-9]{0,8}|0):'
+        +     '(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|'
+        +     '6[0-4][0-9]{3}|'
+        +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))|';
+      }
+
+      description
+        "A Route Distinguisher is an 8-octet value used to
+        distinguish routes from different BGP VPNs (RFC 4364).
+        A Route Distinguisher will have the same format as a
+        Route Target as per RFC 4360 and will consist of
+        two or three fields: a 2-octet Type field, an administrator
+        field, and, optionally, an assigned number field.
+
+        According to the data formats for types 0, 1, and 2 as
+        defined in RFC 4360, and RFC 5668, the encoding
+        pattern is defined as:
+
+        0:2-octet-asn:4-octet-number
+        1:4-octet-ipv4addr:2-octet-number
+        2:4-octet-asn:2-octet-number
+
+        Some valid examples are 0:100:100, 1:1.1.1.1:100,
+        and 2:1234567890:203";
+      reference
+        "RFC 4360: BGP Extended Communities Attribute.
+        RFC 4364: BGP/MPLS IP Virtual Private Networks (VPNs).
+        RFC 5668: 4-Octet AS Specific BGP Extended Community.";
+    }
+
+    typedef route-target-type {
+      type enumeration {
+        enum import {
+          value 0;
+          description
+            "The Route Target applies to route import.";
+        }
+        enum export {
+          value 1;
+          description
+            "The Route Target applies to route export.";
+        }
+
+        enum both {
+          value 2;
+          description
+            "The Route Target applies to both route import and
+            route export.";
+        }
+      }
+      description
+        "Indicates the role a Route Target takes in route filtering.";
+      reference
+        "RFC 4364: BGP/MPLS IP Virtual Private Networks (VPNs).";
+    }
+
+    /*** Collection of types related to VPNs ***/
+
+    typedef route-target {
+      type string {
+        pattern
+          '(0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|'
+        +     '6[0-4][0-9]{3}|'
+        +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0):(429496729[0-5]|'
+        +     '42949672[0-8][0-9]|'
+        +     '4294967[01][0-9]{2}|429496[0-6][0-9]{3}|'
+        +     '42949[0-5][0-9]{4}|'
+        +     '4294[0-8][0-9]{5}|429[0-3][0-9]{6}|'
+        +     '42[0-8][0-9]{7}|4[01][0-9]{8}|'
+        +     '[1-3][0-9]{9}|[1-9][0-9]{0,8}|0))|'
+        + '(1:((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|'
+        +     '25[0-5])\.){3}([0-9]|[1-9][0-9]|'
+        +     '1[0-9]{2}|2[0-4][0-9]|25[0-5])):(6553[0-5]|'
+        +     '655[0-2][0-9]|'
+        +     '65[0-4][0-9]{2}|6[0-4][0-9]{3}|'
+        +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))|'
+        + '(2:(429496729[0-5]|42949672[0-8][0-9]|'
+        +     '4294967[01][0-9]{2}|'
+        +     '429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|'
+        +     '4294[0-8][0-9]{5}|'
+        +     '429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[01][0-9]{8}|'
+        +     '[1-3][0-9]{9}|[1-9][0-9]{0,8}|0):'
+        +     '(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|'
+        +     '6[0-4][0-9]{3}|'
+        +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))|';
+      }
+
+      description
+        "A Route Target is an 8-octet BGP extended community
+        initially identifying a set of sites in a BGP VPN
+        (RFC 4364).  However, it has since taken on a more general
+        role in BGP route filtering.  A Route Target consists of two
+        or three fields: a 2-octet Type field, an administrator
+        field, and, optionally, an assigned number field.
+
+        According to the data formats for types 0, 1, 2, and 6 as
+        defined in RFC 4360, and RFC 5668, the encoding
+        pattern is defined as:
+
+        0:2-octet-asn:4-octet-number
+        1:4-octet-ipv4addr:2-octet-number
+        2:4-octet-asn:2-octet-number
+
+        Some valid examples are 0:100:100, 1:1.1.1.1:100,
+        and 2:1234567890:203";
+      reference
+        "RFC 4360: BGP Extended Communities Attribute.
+        RFC 4364: BGP/MPLS IP Virtual Private Networks (VPNs).
+        RFC 5668: 4-Octet AS Specific BGP Extended Community.";
+    }
+
+    grouping vpn-route-targets {
+      description
+        "A grouping that specifies Route Target import-export rules
+        used in BGP-enabled VPNs.";
+      reference
+        "RFC 4364: BGP/MPLS IP Virtual Private Networks (VPNs).
+        RFC 4664: Framework for Layer 2 Virtual Private Networks
+        (L2VPNs).";
+      list vpn-target {
+        key "route-target";
+        description
+          "List of Route Targets.";
+        leaf route-target {
+          type rt-types:route-target;
+          description
+            "Route Target value.";
+        }
+        leaf route-target-type {
+          type rt-types:route-target-type;
+          mandatory true;
+          description
+            "Import/export type of the Route Target.";
+        }
+      }
+    }
+
+     typedef route-origin {
+       type string {
+         pattern
+           '(0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|'
+         +     '6[0-4][0-9]{3}|'
+         +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0):(429496729[0-5]|'
+         +     '42949672[0-8][0-9]|'
+         +     '4294967[01][0-9]{2}|429496[0-6][0-9]{3}|'
+         +     '42949[0-5][0-9]{4}|'
+         +     '4294[0-8][0-9]{5}|429[0-3][0-9]{6}|'
+         +     '42[0-8][0-9]{7}|4[01][0-9]{8}|'
+         +     '[1-3][0-9]{9}|[1-9][0-9]{0,8}|0))|'
+         + '(1:((([0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|'
+         +     '25[0-5])\.){3}([0-9]|[1-9][0-9]|'
+         +     '1[0-9]{2}|2[0-4][0-9]|25[0-5])):(6553[0-5]|'
+         +     '655[0-2][0-9]|'
+         +     '65[0-4][0-9]{2}|6[0-4][0-9]{3}|'
+         +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))|'
+         + '(2:(429496729[0-5]|42949672[0-8][0-9]|'
+         +     '4294967[01][0-9]{2}|'
+         +     '429496[0-6][0-9]{3}|42949[0-5][0-9]{4}|'
+         +     '4294[0-8][0-9]{5}|'
+         +     '429[0-3][0-9]{6}|42[0-8][0-9]{7}|4[01][0-9]{8}|'
+         +     '[1-3][0-9]{9}|[1-9][0-9]{0,8}|0):'
+         +     '(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|'
+         +     '6[0-4][0-9]{3}|'
+         +     '[1-5][0-9]{4}|[1-9][0-9]{0,3}|0))|';
+       }
+       description
+         "A Route Origin is an 8-octet BGP extended community
+          identifying the set of sites where the BGP route
+          originated (RFC 4364).  A Route Origin will have the same
+          format as a Route Target as per RFC 4360 and will consist
+          of two or three fields: a 2-octet Type field, an
+          administrator field, and, optionally, an assigned number
+          field.
+
+          According to the data formats for types 0, 1, 2, and 6 as
+          defined in RFC 4360, RFC 5668, and RFC 7432, the encoding
+          pattern is defined as:
+
+          0:2-octet-asn:4-octet-number
+          1:4-octet-ipv4addr:2-octet-number
+          2:4-octet-asn:2-octet-number
+
+          Some valid examples are 0:100:100, 1:1.1.1.1:100,
+          and 2:1234567890:203";
+       reference
+         "RFC 4360: BGP Extended Communities Attribute.
+          RFC 4364: BGP/MPLS IP Virtual Private Networks (VPNs).
+          RFC 5668: 4-Octet AS Specific BGP Extended Community.
+          RFC 7432: BGP MPLS-Based Ethernet VPN.";
+     }
+
+    /*** Collection of types related to MPLS ***/
+    typedef mpls-label {
+        type uint32 {
+            graphnos:codegen-as-type "MplsLabel";
+            range "0..1048575";
+        }
+        description
+          "The 20-bit label value in an MPLS label stack as specified
+           in RFC 3032.  This label value does not include the
+           encodings of Traffic Class and TTL.";
+        reference
+          "RFC 3032: MPLS Label Stack Encoding.";
+    }
+
+    /*** Groupings **/
+    grouping mpls-label-stack {
+        description
+          "This grouping specifies an MPLS label stack.  The label
+           stack is encoded as a leaf list of label stack entries";
+        container mpls-label-stack {
+            description
+              "Container for a list of MPLS label stack entries.";
+            leaf-list label {
+                type rt-types:mpls-label;
+                description
+                  "Label value.";
+            }
+        }
+    }
+}
diff --git a/tests/files/graphnos-yang-revisions.yang b/tests/files/graphnos-yang-revisions.yang
new file mode 100644
index 0000000..a69a76c
--- /dev/null
+++ b/tests/files/graphnos-yang-revisions.yang
@@ -0,0 +1,128 @@
+module graphnos-yang-revisions {
+    yang-version "1.1";
+    namespace "http://graphiant.com/ns/yang/graphnos-yang-revisions";
+    prefix rev;
+
+    organization
+      "Graphiant";
+    contact
+      "yang@graphiant.com";
+
+    description
+      "This YANG 1.1 module contains definitions and extensions to support
+       updated YANG revision handling in Graphnos.
+       
+       Copyright (c) 2021 IETF Trust and the persons identified as
+       authors of the code.  All rights reserved.
+       
+       Redistribution and use in source and binary forms, with or
+       without modification, is permitted pursuant to, and subject
+       to the license terms contained in, the Simplified BSD License
+       set forth in Section 4.c of the IETF Trust's Legal Provisions
+       Relating to IETF Documents
+       (https://trustee.ietf.org/license-info).
+       
+       Copyright (C) 2021 Graphiant, Inc.
+       All rights reserved.";
+
+    revision 2021-11-02 {
+        description
+          "Initial revision";
+        reference
+          "draft-ietf-netmod-yang-module-versioning-04 and 
+           draft-ietf-netmod-yang-semver-04";
+        rev:revision-label 0.0.2;
+    }
+
+    typedef revision-label {
+        type string {
+            pattern '[0-9]+[.][0-9]+[.][0-9]+(_(non_)?compatible)?'
+            + '(-[A-Za-z0-9.-]+[.-][0-9]+)?([+][A-Za-z0-9.-]+)?';
+        }
+        description
+          "A label associated with a YANG revision.
+           Alphanumeric characters, comma, hyphen, underscore, period
+           and plus are the only accepted characters. MUST NOT match
+           revision-date.
+           
+           Represents a YANG semantic version number.
+           
+           This is a 'merge' of draft-ietf-netmod-yang-semver-04's revision-label
+           with draft-ietf-netmod-yang-semver-04's version. Because unlike what
+           is being defined at the IETF, we only need 1 'versioning scheme'.";
+        reference
+          "draft-ietf-netmod-yang-module-versioning-04: Updated YANG Module Revision Handling;
+           Section 3.4, Revision label.
+           draft-ietf-netmod-yang-semver-04: YANG Semver;
+           Section 3.2, Semantic Versioning for YANG Artifacts.
+          ";
+    }
+
+    extension non-backwards-compatible {
+        description
+          "This statement is used to indicate YANG module revisions that
+           contain non-backwards-compatible changes.
+           
+           The statement MUST only be a substatement of the 'revision'
+           statement.  Zero or one 'non-backwards-compatible' statements
+           per parent statement is allowed.  No substatements for this
+           extension have been standardized.
+           
+           If a revision of a YANG module contains changes, relative to
+           the preceding revision in the revision history, that do not
+           conform to the backwards compatible module update rules defined
+           in draft-ietf-netmod-yang-module-versioning-04, then the 
+           'non-backwards-compatible' statement MUST
+           be added as a substatement to the revision statement.
+           
+           Conversely, if a revision does not contain a
+           'non-backwards-compatible' statement then all changes,
+           relative to the preceding revision in the revision history,
+           MUST be backwards-compatible.
+           
+           A new module revision that only contains changes that are
+           backwards compatible SHOULD NOT include the
+           'non-backwards-compatible' statement.  An example of when
+           an author might add the 'non-backwards-compatible' statement
+           is if they believe a change could negatively impact clients
+           even though the backwards compatibility rules defined in
+           draft-ietf-netmod-yang-module-versioning-04 classify it as a 
+           backwards-compatible change.
+           
+           Adding, removing, or changing a 'non-backwards-compatible'
+           statement is a backwards-compatible version change.";
+
+        reference
+          "draft-ietf-netmod-yang-module-versioning-04: Updated YANG Module Revision Handling;
+           Section 3.2, non-backwards-compatible revision extension statement";
+    }
+
+    extension revision-label {
+        argument revision-label;
+        description
+          "The revision label can be used to provide an additional
+           versioning identifier associated with a module or submodule
+           revision. 
+           
+           The format of the revision-label argument MUST conform to the
+           pattern defined for the revision-label typedef in this module.
+           
+           The statement MUST only be a substatement of the revision
+           statement. Zero or one revision-label statements per parent
+           statement are allowed. No substatements for this extension
+           have been standardized.
+           
+           Revision labels MUST be unique amongst all revisions of a
+           module or submodule.
+           
+           Adding a revision label is a backwards-compatible version
+           change. Changing or removing an existing revision label in
+           the revision history is a non-backwards-compatible version
+           change, because it could impact any references to that
+           revision label.";
+
+        reference
+          "draft-ietf-netmod-yang-module-versioning-04: Updated YANG Module Revision Handling;
+           Section 3.4, Revision label";
+    }
+}
