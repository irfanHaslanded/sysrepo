             "LD_LIBRARY_PATH=${CMAKE_BINARY_DIR}"
         )
 
@@ -98,8 +99,9 @@ if(ENABLE_TESTS)
     endforeach()
     add_test(NAME test_sysrepocfg_oper_import COMMAND ${PROJECT_SOURCE_DIR}/tests/test_sysrepocfg_oper.sh WORKING_DIRECTORY ${CMAKE_BINARY_DIR})
     set_property(TEST test_sysrepocfg_oper_import APPEND PROPERTY ENVIRONMENT
-        "SYSREPO_REPOSITORY_PATH=${PROJECT_BINARY_DIR}/test_repositories/${test_name}"
+        "SYSREPO_REPOSITORY_PATH=${PROJECT_BINARY_DIR}/test_repositories/test_sysrepocfg_oper_import"
         "SYSREPO_SHM_PREFIX=_tests_sr_${test_name}"
+        "SYSREPO_SHM_DIR=/dev/shm/_tests_sr_dir_test_sysrepocfg_oper_import"
         "LD_LIBRARY_PATH=${CMAKE_BINARY_DIR}"
     )
 
@@ -128,6 +130,7 @@ if(ENABLE_VALGRIND_TESTS)
         set_property(TEST ${test_name} APPEND PROPERTY ENVIRONMENT
             "SYSREPO_REPOSITORY_PATH=${PROJECT_BINARY_DIR}/test_repositories/${test_name}"
             "SYSREPO_SHM_PREFIX=_tests_sr_${test_name}"
+            "SYSREPO_SHM_DIR=/dev/shm/_tests_sr_dir_${test_name}"
             "LD_LIBRARY_PATH=${CMAKE_BINARY_DIR}"
         )
 
