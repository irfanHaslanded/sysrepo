+static int
+sr_modinfo_load_srmon_single_module(const char *xpath, char *mod_name, int *change_sub_only)
+{
+    char q1 = 0, q2 = 0;
+    char buf[128] = "";
+    int result, len;
+    *change_sub_only = 0;
+
+    if (strchr(xpath, '|')) {
+        return 0;
+    }
+
+    if (3 == sscanf(xpath, "/sysrepo-monitoring:sysrepo-state/module[name=%c%64[^\"\']%c]",
+                &q1, mod_name, &q2)) {
+        result = (q1 == q2) && (q1 == '\"' || q1 == '\'');
+        if (!result) {
+            return 0;
+        }
+
+        len = snprintf(buf, sizeof(buf), "/sysrepo-monitoring:sysrepo-state/module[name=\"%s\"]/subscriptions/change-sub/xpath", mod_name);
+
+        if (!strncmp(buf, xpath, len)) {
+            *change_sub_only = 1;
+        }
+        return 1;
+    }
+
+    return 0;
+}
