+++ b/tests/test_lock_log.c
@@ -0,0 +1,382 @@
+/**
+ * @file test_lock_log.c
+ * @author Irfan <irfan@graphiant.com>
+ * @brief test for sr_rwlock_t logging
+ *
+ * @copyright
+ * Copyright 2022 Graphiant
