+        leaf leaf-union-default2 {
+            description
+              "A leaf using a typedef that is a union containing an enhanced type with a default.";
+            type inet:host;
+            default "127.0.0.1";
+        }
+        leaf identityref-default {
+            description
+              "A leaf using an identityref with a default.";
+            type identityref {
+                base some-type;
+            }
+            default "basic-type";
+        }
+
+        container oper-container {
+            config false;
+            description
+              "A non-presence operational-only container.";
+
+            leaf leaf-bool {
+                type boolean;
+                description
+                  "Boolean leaf.";
+            }
+        }
+
+        list list-enh {
+            key "date-and-time label";
+            leaf date-and-time {
+                type yang:date-and-time;
+                description
+                  "A leaf using yang:date-and-time.";
+            }
+            leaf label {
+                type mpls-label;
+                description
+                    "Label.";
+            }
+            description
+                "List with enhanced values as keys.";
+        }
+
+        container container {
+          description
+            "A nested container that has the same name than the parent container.";
+        }
+    }
+
+    rpc clear-stats {
+        description
+          "An RPC with inputs and outputs.";
+        input {
+            leaf interface {
+                type string;
+            }
+        }
+        output {
+            leaf old-stats {
+                type uint64;
+            }
+        }
+    }
+
+    rpc empty {
+        description
+          "An RPC with no inputs or outputs.";
+    }
+
+    rpc rpc-with-containers {
+        input {
+            container presence {
+                presence "test";
+                description
+                    "A container with presence";
+            }
+        }
+        output {
+            container presence {
+                presence "test";
+                description
+                    "A container with presence";
+            }
+        }
+        description
+          "An RPC with presence containers as inputs and outputs.";
+    }
+
+    rpc rpc-with-non-presence-containers {
+        input {
+            container presence {
+                description
+                    "A container without presence";
+            }
+        }
+        output {
+            container presence {
+                description
+                    "A container without presence";
+            }
+        }
+        description
+          "An RPC with non-presence containers as inputs and outputs.";
+    }
+}
